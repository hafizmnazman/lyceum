}

function Avatar(props: { name: string }) {
  const initials = props.name
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("");
  return (
    <span
      aria-hidden
      style={{
        width: 24,
        height: 24,
        borderRadius: "50%",
        background: "var(--accent-soft)",
        color: "var(--accent)",
