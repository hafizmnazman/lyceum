// The guided journey: a horizontal bar in Course Studio and a card on Home.
// Both read the same computed steps, so "done" means the workspace holds the
// result, and "next" is always one concrete action.

import { ArrowRight, Check } from "lucide-react";
import { journeyFor, nextJourneyStep } from "../../app/journey.ts";
import { navigate, selectStudioTab, selectSubject, type AppState } from "../../app/store.ts";
import { Button, Tag } from "./index.tsx";

function go(step: { screen: "courses" | "studio" | "inbox" | string; tab?: AppState["studioTab"] }, subjectId: string | null) {
  if (step.screen === "studio") { if (subjectId) selectSubject(subjectId); if (step.tab) selectStudioTab(step.tab); navigate("studio"); return; }
  navigate(step.screen as "courses");
}

export function JourneyBar({ state, subjectId }: { state: AppState; subjectId: string }) {
  const steps = journeyFor(state, subjectId);
  const next = nextJourneyStep(steps);
  const done = steps.filter((s) => s.done).length;
  return <nav className="journey-bar" aria-label="Your progress on this course" data-demo-id="journey-bar">
    <ol className="journey-steps">
      {steps.map((step, index) => <li key={step.id} className={step.done ? "is-done" : step.id === next?.id ? "is-next" : ""}>
        <button type="button" onClick={() => go(step, subjectId)} aria-current={step.id === next?.id ? "step" : undefined} aria-label={step.title + (step.done ? ", done" : step.id === next?.id ? ", next" : "")}>
          <span className="journey-mark" aria-hidden>{step.done ? <Check size={13} /> : index + 1}</span>
          <span className="journey-title">{step.title}</span>
        </button>
      </li>)}
    </ol>
    <div className="journey-next">
      {next ? <><Tag tone="accent">Next</Tag><span>{next.help}</span><Button variant="quiet" onClick={() => go(next, subjectId)}>{next.title} <ArrowRight size={14} /></Button></>
        : <><Tag tone="ok">All seven steps done</Tag><span>{done} of {steps.length}. Refresh the evidence next term, or send the brief to another colleague.</span></>}
    </div>
  </nav>;
}

export function JourneyCard({ state, subjectId, title }: { state: AppState; subjectId: string | null; title?: string }) {
  const steps = journeyFor(state, subjectId);
  const next = nextJourneyStep(steps);
  const done = steps.filter((s) => s.done).length;
  return <section className="workspace-panel journey-card" aria-labelledby="journey-card-title" data-demo-id="journey-card">
    <div className="section-heading"><div><h2 id="journey-card-title">{title ?? (subjectId ? "Your progress on " + subjectId : "Start here")}</h2>
      <p className="muted">{done} of {steps.length} steps done. Each step is one screen and one action; the guide reads your real work.</p></div>
      {next ? <Button variant="primary" onClick={() => go(next, subjectId)} data-demo-id="journey-next">{next.title} <ArrowRight size={15} /></Button> : null}</div>
    <ol className="journey-grid">
      {steps.map((step, index) => <li key={step.id} className={step.done ? "is-done" : step.id === next?.id ? "is-next" : ""}>
        <span className="journey-mark" aria-hidden>{step.done ? <Check size={14} /> : index + 1}</span>
        <div><strong>{step.title}</strong><p className="muted">{step.done ? step.count : step.help}</p></div>
        <Button variant="quiet" aria-label={(step.done ? "Open " : "Do ") + step.title} onClick={() => go(step, subjectId)}>{step.done ? "Open" : "Do it"}</Button>
      </li>)}
    </ol>
  </section>;
}
// The lecturer's journey, computed from real state so the guide never lies:
// a step is done when the workspace holds the thing it produces.

import type { AppState } from "./store.ts";
import type { Screen } from "./roles.ts";

export interface JourneyStep {
  id: string;
  title: string; // two or three words
  help: string; // one sentence: what to do
  done: boolean;
  count: string; // what exists, for example "3 sources"
  screen: Screen;
  tab?: AppState["studioTab"];
}

export function journeyFor(state: AppState, subjectId: string | null): JourneyStep[] {
  const id = subjectId ?? "";
  const definition = id ? state.courseDefinitions[id] : undefined;
  const adopted = state.curriculumDrafts.some((d) => d.subjectId === id && d.status === "adopted");
  const sources = state.evidenceSources.filter((s) => s.subjectId === id);
  const reviewed = sources.filter((s) => s.reviewed && !s.duplicateOf);
  const mentions = state.skillMentions.filter((m) => m.subjectId === id);
  const mappings = state.skillMappings.filter((m) => m.subjectId === id);
  const sessions = state.teachingPlans.find((p) => p.subjectId === id)?.sessions ?? [];
  const briefs = state.evidenceBriefs.filter((b) => b.subjectId === id);
  const outcomes = state.clos.filter((c) => c.subjectId === id);
  return [
    { id: "course", title: "Open a course", help: "Pick an assigned course or create a personal workspace.", done: Boolean(id), count: id || "none yet", screen: "courses" },
    { id: "outline", title: "Confirm the outline", help: "Start a revision, check the outcomes and topics against the hours, and adopt the version.",
      done: adopted || (definition?.topics.length ?? 0) > 0, count: outcomes.length + " outcomes, " + (definition?.topics.length ?? 0) + " topics", screen: "studio", tab: "curriculum" },
    { id: "collect", title: "Collect evidence", help: "Fetch postings from an employer board and keep the ones worth reading.", done: sources.length > 0,
      count: sources.length + " sources", screen: "studio", tab: "evidence" },
    { id: "confirm", title: "Confirm quotations", help: "Scan for the skills you name, confirm each exact quotation, mark the postings reviewed.",
      done: mentions.length > 0 && reviewed.length > 0, count: mentions.length + " quotations, " + reviewed.length + " reviewed", screen: "studio", tab: "evidence" },
    { id: "map", title: "Map to outcomes", help: "Say what the course does about each skill today and what it should reach.", done: mappings.length > 0,
      count: mappings.length + " mapped", screen: "studio", tab: "evidence" },
    { id: "plan", title: "Plan a class", help: "Save a session linked to an outcome and download its teaching pack.", done: sessions.length > 0,
      count: sessions.length + " sessions", screen: "studio", tab: "plan" },
    { id: "brief", title: "Brief the meeting", help: "Prepare the brief, download it as slides, or send it to a colleague.", done: briefs.length > 0,
      count: briefs.filter((b) => b.sentAt).length + " sent of " + briefs.length, screen: "studio", tab: "evidence" },
  ];
}

export function nextJourneyStep(steps: JourneyStep[]): JourneyStep | null {
  return steps.find((s) => !s.done) ?? null;
}

