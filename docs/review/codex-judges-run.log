        e.preventDefault();
        setPaletteOpen((v) => !v);
      }
      if (e.key === "Escape") { setMenuOpen(false); setNavOpen(false); }
    }
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  // Click-away for the account menu.
