1: // What actually happened, step by step, told by role. Every event is derived
2: // from a record the workspace holds (a source, a quotation, a version, a brief),
3: // so the timeline can only show work that was really done.
4: 
5: import type { AppState } from "./store.ts";
6: import { SOURCE_POLICIES } from "../lib/collect.ts";
7: import { evidenceReport } from "../lib/evidence.ts";
8: 
9: export type RoleId = "folio" | "scout" | "atlas" | "quill" | "prism" | "lens" | "steward";
10: export interface Role { id: RoleId; name: string; job: string; reads: string; produces: string; cannot: string }
11: export const ROLES: Role[] = [
12:   { id: "folio", name: "Folio", job: "Course reader", reads: "Your syllabus, outline and uploaded documents", produces: "A course record with outcomes, topics and locators", cannot: "Declare a document official" },
13:   { id: "scout", name: "Scout", job: "Industry researcher", reads: "Permitted employer boards, on your request", produces: "Postings with link, publication date, retrieval time and text", cannot: "Collect without being asked, or change the curriculum" },
14:   { id: "atlas", name: "Atlas", job: "Curriculum mapper", reads: "The kept postings and the skills you name", produces: "Proposed exact quotations and skill-to-outcome mappings for you to confirm", cannot: "Confirm a quotation or a mapping for you" },
15:   { id: "quill", name: "Quill", job: "Course designer", reads: "The course brief, constraints and the evidence you confirmed", produces: "Outline revisions checked against hours, links and protected topics", cannot: "Approve its own revision" },
16:   { id: "prism", name: "Prism", job: "Teaching-material creator", reads: "A saved session and the evidence linked to its outcomes", produces: "An editable teaching pack with speaker notes", cannot: "Publish anything or write a word with a model" },
17:   { id: "lens", name: "Lens", job: "Evidence analyst", reads: "Reviewed postings and confirmed quotations", produces: "Counts with the denominator, intervals, coverage against targets", cannot: "Score employability or predict learning" },
18:   { id: "steward", name: "Steward", job: "Review assistant", reads: "The brief, its sources and the decision context", produces: "A brief with receipts, sent to the people who decide", cannot: "Decide; the lecturer and the university do" },
19: ];
20: 
21: export interface RunEvent { at: string; role: RoleId; title: string; detail: string; tab?: AppState["studioTab"] }
22: 
23: const time = (iso: string) => iso;
24: 
25: export function runTimeline(state: AppState, subjectId: string | null): RunEvent[] {
26:   if (!subjectId) return [];
27:   const events: RunEvent[] = [];
28:   const name = (id: string) => state.people.find((p) => p.id === id)?.name ?? id;
29:   for (const draft of state.curriculumDrafts.filter((d) => d.subjectId === subjectId)) {
30:     for (const h of draft.history) {
31:       const titles: Record<string, string> = { created: "Revision started", saved: "Revision saved", checked: "Constraints checked", adopted: "Version adopted", discarded: "Revision discarded" };
32:       events.push({ at: h.at, role: "quill", title: titles[h.action] ?? h.action, detail: h.note + " (" + name(h.byPersonId) + ")", tab: h.action === "adopted" ? "history" : "curriculum" });
33:     }
34:   }
35:   const sources = state.evidenceSources.filter((s) => s.subjectId === subjectId);
36:   const batches = new Map<string, typeof sources>();
37:   for (const s of sources.filter((x) => x.collection)) {
38:     const key = s.collection!.label + "|" + s.collection!.retrievedAt;
39:     batches.set(key, [...(batches.get(key) ?? []), s]);
40:   }
41:   for (const [, batch] of batches) {
42:     const first = batch[0];
43:     const policy = SOURCE_POLICIES[first.collection!.provider];
44:     events.push({ at: first.addedAt, role: "scout", title: "Fetched on request, " + batch.length + " postings kept", detail: policy.name + " Â· retrieved " + time(first.collection!.retrievedAt) + " Â· " + batch.filter((b) => b.duplicateOf).length + " duplicate copies", tab: "evidence" });
45:   }
46:   for (const s of sources.filter((x) => !x.collection)) events.push({ at: s.addedAt, role: "folio", title: "Document recorded: " + s.title, detail: (s.organisation || "organisation not named") + " Â· pasted by " + name(s.addedBy), tab: "evidence" });
47:   const mentions = state.skillMentions.filter((m) => m.subjectId === subjectId);
48:   const byMinute = new Map<string, number>();
49:   for (const m of mentions) { const key = m.addedAt.slice(0, 16); byMinute.set(key, (byMinute.get(key) ?? 0) + 1); }
50:   for (const [minute, count] of byMinute) events.push({ at: minute + ":00.000Z", role: "atlas", title: count + " exact quotations confirmed", detail: "Each verified against its source text; paraphrases rejected", tab: "evidence" });
51:   const reviewed = sources.filter((s) => s.reviewed && !s.duplicateOf);
52:   if (reviewed.length) {
53:     const report = evidenceReport(subjectId, state.evidenceSources, state.skillMentions, state.skillMappings, state.clos.filter((c) => c.subjectId === subjectId));
54:     const latest = reviewed.map((s) => s.addedAt).sort().at(-1)!;
55:     const top = report.rows.filter((r) => r.postings > 0).slice(0, 3).map((r) => r.skill + " " + r.postings + " of " + report.eligible).join(", ");
56:     events.push({ at: latest, role: "lens", title: "Counted over " + report.eligible + " reviewed postings", detail: top ? "Top: " + top + ". Wilson 95% intervals shown; no score." : "No requirement quoted yet", tab: "evidence" });
57:   }
58:   for (const m of state.skillMappings.filter((x) => x.subjectId === subjectId)) {
59:     const labels = m.cloIds.map((id) => state.clos.find((c) => c.id === id)?.label ?? id).join(", ") || "no outcome";
60:     events.push({ at: m.updatedAt, role: "atlas", title: "Mapped " + m.skill + " to " + labels, detail: "Coverage " + m.stage + ", target " + m.target + (m.evidence ? " Â· " + m.evidence : ""), tab: "evidence" });
61:   }
62:   for (const s of state.teachingPlans.find((p) => p.subjectId === subjectId)?.sessions ?? []) events.push({ at: s.updatedAt, role: "prism", title: "Session saved: week " + s.week + ", " + s.topic, detail: s.minutes + " minutes Â· " + (s.cloIds.length ? "linked to " + s.cloIds.join(", ") : "no outcome linked") + " Â· teaching pack available", tab: "plan" });
63:   for (const t of state.testDrafts.filter((x) => x.subjectId === subjectId)) if (t.items.length) events.push({ at: state.subjectVersions.find((v) => v.id === t.courseVersionId)?.changedAt ?? "", role: "quill", title: t.items.length + " template assessment items drafted", detail: "Blueprint over " + t.blueprint.cloWeights.length + " outcomes Â· labelled as templates", tab: "assessment" });
64:   for (const b of state.evidenceBriefs.filter((x) => x.subjectId === subjectId)) {
65:     events.push({ at: b.createdAt, role: "steward", title: "Meeting brief prepared", detail: b.recommendation + " Â· by " + name(b.createdBy) + " Â· receipts attached", tab: "evidence" });
66:     if (b.sentAt) events.push({ at: b.sentAt, role: "steward", title: "Brief sent to " + b.recipients.map(name).join(", "), detail: "Read " + (state.notifications.filter((n) => n.briefId === b.id && n.read).length) + " of " + b.recipients.length + " so far", tab: "evidence" });
67:   }
68:   return events.filter((e) => e.at).sort((a, b) => a.at.localeCompare(b.at));
69: }
