.curriculum-fields { min-width: 0; margin: 0; padding: 0; border: 0; }
.revision-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 0; }
.curriculum-object { border-top: 1px solid var(--border); padding: 20px 0 8px; overflow-wrap: anywhere; }
.curriculum-object:first-of-type { border-top: 0; }
.curriculum-object h4 { margin: 0; }
.checkbox-line { display: flex; align-items: flex-start; gap: 10px; min-height: 44px; padding: 10px 0; cursor: pointer; line-height: 1.6; }
.checkbox-line input { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 3px; accent-color: var(--accent); }
.revision-issues { list-style: none; padding: 0; margin: 12px 0; }
.evidence-text { max-height: 18rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; padding: 10px 12px; background: var(--surface-2); border-radius: var(--radius-s); margin: 8px 0; }
.table-scroll { overflow-x: auto; max-width: 100%; }
.evidence-table { border-collapse: collapse; width: 100%; font-size: 13px; }
.evidence-table caption { text-align: left; caption-side: bottom; padding: 8px 0; font-size: 12px; }
.evidence-table th, .evidence-table td { text-align: left; padding: 8px 10px; border-top: 1px solid var(--border); vertical-align: top; }
.evidence-table thead th { font-weight: 500; color: var(--ink-2); border-top: 0; }
.evidence-table tbody th { font-weight: 500; }
.mention-list { list-style: none; padding: 0; margin: 8px 0; }
.mention-list li { border-top: 1px solid var(--border); padding: 8px 0; }
.collect-log { list-style: none; padding: 10px 12px; margin: 8px 0 12px; background: var(--surface-2); border-radius: var(--radius-s); font-family: ui-monospace, Consolas, "Courier New", monospace; font-size: 12px; line-height: 1.5; color: var(--ink-2); display: flex; flex-direction: column; gap: 4px; overflow-wrap: anywhere; }
.brief-body { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 13px; line-height: 1.5; max-height: 36rem; overflow: auto; padding: 12px 14px; margin: 8px 0; background: var(--surface-2); border-radius: var(--radius-s); }
.proposal-quote { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
.mention-list blockquote { margin: 6px 0 0; padding-left: 10px; border-left: 2px solid var(--border); white-space: pre-wrap; overflow-wrap: anywhere; }
.revision-issues li { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; }
.revision-issues li span:last-child { min-width: 0; overflow-wrap: anywhere; }
.revision-diff article { border-top: 1px solid var(--border); padding: 16px 0; overflow-wrap: anywhere; }
.revision-diff .session-content { margin-top: 12px; }
.revision-diff h4 { margin: 0; color: var(--ink-2); }
.workspace-panel .course-facts { flex-wrap: wrap; }
.curriculum-fields:disabled { opacity: .85; }
@media (max-width: 600px) {
  .curriculum-object .section-heading { align-items: flex-start; flex-direction: column; }
  .revision-issues li { flex-wrap: wrap; }
}

