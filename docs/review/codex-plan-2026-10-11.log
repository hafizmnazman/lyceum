              className="account-trigger"
              aria-label={"Account: " + person.name}
              aria-expanded={menuOpen}
              aria-controls="account-options"
              data-demo-id="account-menu"
              onClick={() => setMenuOpen((v) => !v)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 8,
                height: 36,
                padding: "0 10px",
