src/ui/shell/Shell.tsx
   1: // The app shell (spec 6.1): persistent sidebar with the person's nav and their
   2: // subjects (hat badges), topbar with breadcrumb, search (command palette),
   3: // notification bell and account menu, the toast, and the right-side agent
   4: // panel. This chrome is what makes Lyceum read as an app you live in rather
   5: // than a deck of screens.
   6: 
   7: import type { ReactNode } from "react";
   8: import { useEffect, useRef, useState } from "react";
