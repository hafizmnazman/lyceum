  416: function updateTeachingPlan(subjectId: SubjectId, update: (plan: TeachingPlan) => TeachingPlan) {
  417:   const previous = state.teachingPlans.find((p) => p.subjectId === subjectId);
  418:   const plan = update(previous ?? { subjectId, term: "", notes: "", sessions: [], updatedAt: nowIso(), updatedBy: state.currentPersonId! });
  419:   const stamped = { ...plan, updatedAt: nowIso(), updatedBy: state.currentPersonId! };
  420:   set((s) => ({ teachingPlans: [...s.teachingPlans.filter((p) => p.subjectId !== subjectId), stamped] }));
  421: }
