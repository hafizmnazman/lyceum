  259: // ---------- persistence (spec: "State persists") ----------
  260: const STORAGE_KEY = "lyceum-v3-state@1";
  261: 
  262: // The slice of state worth keeping across refreshes: the mutable world and the
  263: // session. Transient UI (sims, drills, toasts, agent runs) always starts clean.
  264: const PERSISTED_KEYS = [
  265:   "programme",
  266:   "assignments",
  267:   "subjects",
  268:   "clos",
  269:   "survey",
  270:   "currentPersonId",
  271:   "screen",
  272:   "selectedSubjectId",
  273:   "selectedProposalId",
  274:   "proposals",
  275:   "notifications",
  276:   "predictions",
  277:   "resultUploads",
  278:   "dataSources",
  279:   "subjectVersions",
  280:   "testDrafts",
  281:   "teachingPlans",
  282:   "courseDefinitions",
  283:   "curriculumDrafts",
  284:   "evidenceSources",
  285:   "skillMentions",
  286:   "skillMappings",
  287:   "evidenceBriefs",
  288:   "skillLexicon",
  289:   "relevanceRatings",
  290:   "idSeq",
  291: ] as const;
  292: 
  293: function loadPersisted(): Partial<AppState> | null {
  294:   if (typeof window === "undefined") return null;
  295:   try {
  296:     const raw = localStorage.getItem(STORAGE_KEY);
  297:     if (!raw) return null;
  298:     const parsed = JSON.parse(raw) as Partial<AppState>;
  299:     // A running sim or a mid-demo screen must not resurrect into a fresh page.
  300:     if (parsed.screen === "login" || parsed.screen === undefined) parsed.currentPersonId = null;
  301:     return parsed;
  302:   } catch {
  303:     return null;
  304:   }
  305: }
  306: 
  307: let saveTimer: ReturnType<typeof setTimeout> | null = null;
  308: function schedulePersist() {
  309:   if (typeof window === "undefined") return;
  310:   if (saveTimer) clearTimeout(saveTimer);
  311:   saveTimer = setTimeout(flushPersistence, 250);
  312: }
  313: 
  314: /** Flush also runs on page exit so a quick refresh cannot discard the last edit. */
  315: export function flushPersistence() {
  316:   if (typeof window === "undefined") return;
  317:   if (saveTimer) clearTimeout(saveTimer);
  318:   saveTimer = null;
  319:   let status: AppState["persistenceStatus"] = "saved";
  320:   try {
  321:     const out: Record<string, unknown> = {};
  322:     for (const k of PERSISTED_KEYS) out[k] = state[k];
  323:     localStorage.setItem(STORAGE_KEY, JSON.stringify(out));
  324:   } catch {
  325:     status = "unavailable";
  326:   }
  327:   if (state.persistenceStatus !== status) {
  328:     state = { ...state, persistenceStatus: status };
  329:     for (const listener of listeners) listener();
  330:   }
  331: }
  332: if (typeof window !== "undefined") window.addEventListener("pagehide", flushPersistence);
  333: 
  334: let state: AppState = (() => {
  335:   const seed = seedState();
  336:   const persisted = loadPersisted();
  337:   return persisted ? { ...seed, ...persisted } : seed;
  338: })();
  339: 
  340: // ---------- external-store plumbing ----------
  341: const listeners = new Set<() => void>();
  342: function emit() {
  343:   if (typeof window !== "undefined" && state.persistenceStatus !== "unavailable")
  344:     state = { ...state, persistenceStatus: "pending" };
  345:   for (const l of listeners) l();
  346:   schedulePersist();
  347: }
  348: function set(patch: Partial<AppState> | ((s: AppState) => Partial<AppState>)) {
  349:   const next = typeof patch === "function" ? patch(state) : patch;
  350:   state = { ...state, ...next };
  351:   emit();
  352: }
  353: export function getState(): AppState {
  354:   return state;
  355: }
  356: // A read-only hook for the headless demo smoke (scripts/demo-smoke.mjs): the
  357: // browser test asserts the demo's end state through this, nothing more.
  358: if (typeof window !== "undefined") {
  359:   (window as unknown as { __lyceum?: { getState: typeof getState } }).__lyceum = { getState };
  360: }
  361: function subscribe(l: () => void): () => void {
  362:   listeners.add(l);
  363:   return () => listeners.delete(l);
  364: }
  365: export function useStore(): AppState {
  366:   return useSyncExternalStore(subscribe, getState, getState);
  367: }
  368: 
  369: function nextId(prefix: string): string {
  370:   const used = new Set([...state.proposals, ...state.notifications, ...state.resultUploads, ...state.subjectVersions,
  371:     ...state.testDrafts, ...state.curriculumDrafts, ...state.agentRuns, ...state.evidenceSources, ...state.skillMentions, ...state.evidenceBriefs, ...state.teachingPlans.flatMap(p => p.sessions)].map(x => x.id));
  372:   let id: string;
  373:   do { id = `${prefix}-${state.idSeq}`; state = { ...state, idSeq: state.idSeq + 1 }; } while (used.has(id));
  374:   return id;
  375: }
