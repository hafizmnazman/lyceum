 1327: /** Whether the test may run now. Two gates, both required:
 1328:  *  1. The ACTOR must have run-test capability on the subject: an academic with a
 1329:  *     hat there. This blocks management and the department from triggering a run.
 1330:  *  2. The PROPOSAL must be ready: already review-approved (status testing), or a
 1331:  *     coordinator's own draft (status drafting + author is the coordinator). This
 1332:  *     stops a lecturer's draft reaching a test without review. */
 1333: export function canRunTest(proposalId: ProposalId): boolean {
 1334:   const p = proposalById(proposalId);
 1335:   if (!p) return false;
 1336:   const person = currentPerson();
 1337:   if (!person || !can(person, "run-test", { subjectId: p.subjectId, assignments: state.assignments }))
 1338:     return false;
 1339:   if (p.status === "testing") return true;
 1340:   if (p.status === "drafting") return authorIsCoordinator(p);
 1341:   return false;
 1342: }
 1343: 
 1344: // ---------- the staged acceptance run ----------
 1345: let simTimer: ReturnType<typeof setInterval> | null = null;
 1346: 
 1347: /** Shared by the staged and immediate runs: enforce the gate, set testing, build
 1348:  *  the proxy cohort for a new subject, and compute the real spine result. */
 1349: function prepareRun(
 1350:   proposalId: ProposalId,
 1351: ): { report: VerdictReport; distribution: AcceptanceDistribution } | null {
 1352:   const p = proposalById(proposalId);
 1353:   const subject = p && subjectById(p.subjectId);
 1354:   if (!p || !subject) return null;
 1355:   if (subject.workspaceOnly) { set({ toast: "Use Outcomes & topics to check this course. The legacy learning scenario has no calibrated data for it." }); return null; }
 1356:   if (p.baselineVersionId && p.baselineVersionId !== subject.currentVersionId) { set({ toast: "The proposal baseline is outdated. Start a revision from the current course version." }); return null; }
 1357:   if (!canRunTest(proposalId)) {
 1358:     set({ toast: "This draft must pass coordinator review before it can be tested." });
 1359:     return null;
 1360:   }
 1361:   patchProposal(proposalId, (pp) => ({
 1362:     ...pp,
 1363:     status: "testing",
 1364:     baselineVersionId: subject.currentVersionId,
 1365:     testedDraftFingerprint: JSON.stringify(pp.draft),
 1366:     history:
 1367:       pp.status === "testing"
 1368:         ? pp.history
 1369:         : [
 1370:             ...pp.history,
 1371:             { at: nowIso(), byPersonId: state.currentPersonId ?? pp.authorId, action: "review-approved" },
 1372:           ],
 1373:   }));
 1374: 
 1375:   // New-subject proposals are tested on an Analogy proxy cohort.
 1376:   const isNew = p.kind === "new-subject";
 1377:   let survey = state.survey;
 1378:   let items = ITEMS;
 1379:   let isProxyCohort = false;
 1380:   if (isNew) {
 1381:     const newCLOs = state.clos.filter((c) => c.subjectId === subject.id);
 1382:     const analogy = runAnalogy(newCLOs, state.subjects, state.survey);
 1383:     setAgent("analogy", "done");
 1384:     survey = analogy.proxySurvey;
 1385:     items = itemsForCLOs(newCLOs);
 1386:     isProxyCohort = true;
 1387:   }
 1388: 
 1389:   setAgent("cohort", "working");
 1390:   return runAcceptanceWithDistribution(p, subject, survey, items, {
 1391:     subjects: state.subjects,
 1392:     isProxyCohort,
 1393:   });
 1394: }
 1395: 
 1396: export function startAcceptanceRun(proposalId: ProposalId) {
 1397:   const prepared = prepareRun(proposalId);
 1398:   if (!prepared) return;
 1399:   const { report, distribution } = prepared;
 1400:   set({ sim: initSim(proposalId, report, distribution), drillOpen: false, drillStep: -1, screen: "acceptance" });
 1401:   selectProposal(proposalId);
 1402: 
 1403:   if (simTimer) clearInterval(simTimer);
 1404:   simTimer = setInterval(() => tickRun(report, distribution), scaleMs(SIM_TICK_MS));
 1405: }
 1406: 
 1407: /** Run without the staged reveal (a "skip animation" path; also used by proofs). */
 1408: export function runAcceptanceImmediate(proposalId: ProposalId) {
 1409:   const prepared = prepareRun(proposalId);
 1410:   if (!prepared) return;
 1411:   set({
 1412:     sim: {
 1413:       ...initSim(proposalId, prepared.report, prepared.distribution),
 1414:       phase: "done",
 1415:       learnersRun: prepared.report.groundedOnLearners,
 1416:       bins: initSim(proposalId, prepared.report, prepared.distribution).finalBins,
 1417:       displayedMastery: prepared.report.projectedMastery,
 1418:     },
 1419:   });
 1420:   finishRun(proposalId, prepared.report);
 1421: }
 1422: 
 1423: function tickRun(report: VerdictReport, _distribution: AcceptanceDistribution) {
 1424:   const sim = state.sim;
 1425:   if (!sim) {
 1426:     if (simTimer) clearInterval(simTimer);
 1427:     simTimer = null;
 1428:     return;
 1429:   }
 1430:   const next = stepSim(sim);
 1431:   set({ sim: next });
 1432:   if (next.phase === "done") {
 1433:     if (simTimer) clearInterval(simTimer);
 1434:     simTimer = null;
 1435:     finishRun(next.proposalId, report);
 1436:   }
 1437: }
 1438: 
 1439: function finishRun(proposalId: ProposalId, report: VerdictReport) {
 1440:   const current = proposalById(proposalId);
 1441:   if (!current || current.baselineVersionId !== subjectById(current.subjectId)?.currentVersionId || current.testedDraftFingerprint !== JSON.stringify(current.draft)) {
 1442:     set({ toast: "The course or proposal changed during the scenario. Its result cannot be used for a decision." }); return;
 1443:   }
 1444:   patchProposal(proposalId, (p) => ({
 1445:     ...p,
 1446:     status: "management-approval",
 1447:     acceptanceResult: report,
 1448:     history: [
 1449:       ...p.history,
 1450:       {
 1451:         at: nowIso(),
 1452:         byPersonId: state.currentPersonId ?? p.authorId,
 1453:         action: "tested",
 1454:         note: `Projected mastery ${report.projectedMastery.toFixed(2)}.`,
 1455:       },
 1456:     ],
 1457:   }));
 1458:   setAgent("cohort", "done");
 1459:   setAgent("evaluator", "needs-input");
 1460:   // Drop any earlier test-done ping for this proposal so a re-run (reject then
 1461:   // test again) does not pile up duplicate pings in management's inbox.
 1462:   set((s) => ({
 1463:     drillOpen: true,
 1464:     agentBubble: { agent: "evaluator", text: `Verdict ready: ${report.projectedMastery.toFixed(2)} projected.` },
 1465:     notifications: s.notifications.filter((n) => !(n.kind === "test-done" && n.proposalId === proposalId)),
 1466:   }));
 1467:   for (const m of state.people.filter((pp) => pp.orgRole === "management")) {
 1468:     notify({
 1469:       toPersonId: m.id,
 1470:       kind: "test-done",
 1471:       subjectId: proposalById(proposalId)?.subjectId,
 1472:       proposalId,
 1473:       agentFindings: report.summary,
 1474:     });
 1475:   }
 1476:   // Live path: the Evaluator writes its own verdict prose for the gate; the
 1477:   // measured numbers in the report are untouched either way.
 1478:   const tested = proposalById(proposalId);
 1479:   augmentLive("evaluator", "Compiling the verdict for management", "approval", {
 1480:     subjectId: tested?.subjectId,
 1481:     kind: tested?.kind,
 1482:     currentMastery: report.currentMastery,
 1483:     projectedMastery: report.projectedMastery,
 1484:     weakest: report.cloMastery.reduce((a, b) => (b.meanP < a.meanP ? b : a), report.cloMastery[0]),
 1485:     prerequisiteConflicts: report.prerequisiteConflicts,
 1486:     groundedOnLearners: report.groundedOnLearners,
 1487:     isProxyCohort: report.isProxyCohort,
 1488:   });
 1489: }
 1490: 
 1491: /** The coordinator's explicit "send this to management" affordance after a test. */
 1492: export function submitToManagement(proposalId: ProposalId) {
 1493:   const p = proposalById(proposalId);
 1494:   if (!p) return;
 1495:   closeDrill();
 1496:   set({ toast: "Verdict sent to management for approval." });
 1497: }
 1498: 
 1499: // ---------- the six-hop drill-down reveal ----------
 1500: let drillTimer: ReturnType<typeof setInterval> | null = null;
 1501: 
 1502: /** Reveal the drill-down one hop at a time (verdict -> CLO4 -> learner -> theta ->
 1503:  *  item -> P), each held long enough to read. Deterministic; the interval scales
 1504:  *  under turbo for the smoke. Works for a human too. */
 1505: export function startDrillReveal() {
 1506:   const report = proposalById(state.selectedProposalId)?.acceptanceResult;
 1507:   if (!report) return;
 1508:   set({ drillOpen: true, drillStep: 0 });
 1509:   if (drillTimer) clearInterval(drillTimer);
 1510:   drillTimer = setInterval(() => {
 1511:     const cur = state.drillStep;
 1512:     if (cur >= DRILL_STEPS - 1) {
 1513:       if (drillTimer) clearInterval(drillTimer);
 1514:       drillTimer = null;
 1515:       return;
 1516:     }
 1517:     set({ drillStep: cur + 1 });
 1518:   }, scaleMs(DRILL_STEP_MS));
 1519: }
 1520: 
 1521: export function closeDrill() {
 1522:   if (drillTimer) clearInterval(drillTimer);
 1523:   drillTimer = null;
 1524:   set({ drillStep: -1 });
 1525: }
 1526: 
 1527: // ---------- management approval gate ----------
 1528: export function approveProposal(proposalId: ProposalId) {
 1529:   const p = proposalById(proposalId), person = currentPerson();
 1530:   if (!person || !p || !can(person, "approve", { subjectId: p.subjectId, assignments: state.assignments })) return;
 1531:   if (!p.acceptanceResult || p.status !== "management-approval") return;
 1532:   const subject = subjectById(p.subjectId);
 1533:   if (!subject || p.baselineVersionId !== subject.currentVersionId || p.testedDraftFingerprint !== JSON.stringify(p.draft)) {
 1534:     set({ toast: "This proposal or its baseline changed. Review and run it again before recording approval." }); return;
 1535:   }
 1536:   const baseline = definitionForCourse(subject.id)!;
 1537:   const definition = structuredClone(baseline);
 1538:   for (const [index,change] of (p.draft.cloChanges ?? []).entries()) {
 1539:     const id = change.cloId ?? subject.id + "-" + p.id + "-outcome-" + (index + 1);
 1540:     const existing = definition.outcomes.find(c => c.id === id);
 1541:     if (change.op === "remove") {
 1542:       if (!existing) { set({ toast: "A removed outcome is no longer in this course." }); return; }
 1543:       definition.outcomes = definition.outcomes.filter(c => c.id !== id);
 1544:     } else if (change.op === "edit") {
 1545:       if (!existing) { set({ toast: "An edited outcome is no longer in this course." }); return; }
 1546:       definition.outcomes = definition.outcomes.map(c => c.id === id ? { ...c, text: change.text, bloomLevel: change.bloomLevel } : c);
 1547:     } else if (existing && p.kind !== "new-subject") {
 1548:       set({ toast: "The proposed new outcome already exists. Review the operation." }); return;
 1549:     } else if (!existing) definition.outcomes.push({ id, subjectId: subject.id, text: change.text,
 1550:       bloomLevel: change.bloomLevel, label: "CLO" + (definition.outcomes.length + 1), assessmentEvidence: "", ploIds: [] });
 1551:   }
 1552:   if (p.draft.topics?.length) definition.topics = p.draft.topics.map((title,index) => {
 1553:     const existing = baseline.topics.find(t => t.title === title);
 1554:     return existing ? structuredClone(existing) : { id: subject.id + "-" + p.id + "-topic-" + index, title, week: null,
 1555:       contactHours: 0, selfStudyHours: 0, cloIds: [], prerequisiteTopicIds: [], protected: false, resources: "" };
 1556:   });
 1557:   const structural = draftStructureError(definition,subject.id);
 1558:   const errors = structural ? [structural] : validateCourseDefinition(definition,subject.id,baseline).filter(i => i.severity === "error").map(i => i.message);
 1559:   if (definition.outcomes.some(c => state.clos.some(other => other.id === c.id && other.subjectId !== subject.id))) errors.push("An outcome identity belongs to another course.");
 1560:   if (errors.length) { set({ toast: "Cannot apply this proposal: " + errors.join(" ") }); return; }
 1561:   const at = nowIso(), versionId = nextId(subject.id + "-v");
 1562:   const impact = curriculumImpact(baseline,definition,state.teachingPlans.find(t => t.subjectId === subject.id),state.testDrafts.filter(t => t.subjectId === subject.id));
 1563:   const version: SubjectVersion = { id: versionId, subjectId: subject.id,
 1564:     snapshot: { title: definition.title, cloIds: definition.outcomes.map(c => c.id), prerequisiteSubjectIds: [...subject.prerequisiteSubjectIds] },
 1565:     cloSnapshot: structuredClone(definition.outcomes), definition: structuredClone(definition),
 1566:     changedBy: person.id, changedAt: at, reason: "Local proposal decision applied. Institutional authority is not verified by the prototype." };
 1567:   set(s => ({
 1568:     proposals: s.proposals.map(pp => pp.id === proposalId ? { ...pp, status: "approved",
 1569:       history: [...pp.history, { at, byPersonId: person.id, action: "approved", note: "Applied to local course version " + versionId + "." }] } : pp),
 1570:     courseDefinitions: { ...s.courseDefinitions, [subject.id]: definition },
 1571:     clos: [...s.clos.filter(c => c.subjectId !== subject.id), ...definition.outcomes],
 1572:     subjects: s.subjects.map(c => c.id === subject.id ? { ...c, title: definition.title, cloIds: definition.outcomes.map(o => o.id), currentVersionId: versionId, status: "active" } : c),
 1573:     subjectVersions: [...(s.subjectVersions.some(v => v.id === subject.currentVersionId)
 1574:       ? s.subjectVersions.map(v => v.id === subject.currentVersionId && !v.definition ? { ...v, definition: structuredClone(baseline) } : v)
 1575:       : [...s.subjectVersions, { id: subject.currentVersionId, subjectId: subject.id,
 1576:           snapshot: { title: subject.title, cloIds: [...subject.cloIds], prerequisiteSubjectIds: [...subject.prerequisiteSubjectIds] },
 1577:           cloSnapshot: structuredClone(baseline.outcomes), definition: baseline, changedBy: person.id, changedAt: at, reason: "Baseline preserved before proposal decision." }]), version],
 1578:     predictions: [...s.predictions, { proposalId, subjectId: subject.id, predictedMastery: p.acceptanceResult!.projectedMastery, madeAt: at }],
 1579:     teachingPlans: s.teachingPlans.map(t => t.subjectId === subject.id ? { ...t, sessions: t.sessions.map(session =>
 1580:       impact.sessions.some(x => x.id === session.id) ? { ...session, needsReview: true, courseVersionId: session.courseVersionId ?? subject.currentVersionId } : session) } : t),
 1581:     testDrafts: s.testDrafts.map(t => impact.assessments.some(x => x.id === t.id) ? { ...t, needsReview: true, status: "drafting" } : t),
 1582:     toast: "Decision applied to a new local course version. The prediction remains an illustrative scenario."
 1583:   }));
 1584:   setAgent("evaluator", "done");
 1585:   notify({ toPersonId: p.authorId, kind: "approved", subjectId: p.subjectId, proposalId,
 1586:     agentFindings: "The prototype reviewer recorded a decision and applied the local course changes." });
 1587: }
 1588: 
 1589: export function rejectProposal(proposalId: ProposalId, note = "Not approved.") {
 1590:   const p = proposalById(proposalId);
 1591:   const person = currentPerson();
 1592:   if (!person || !can(person, "approve", { subjectId: p?.subjectId, assignments: state.assignments })) return;
 1593:   if (!p || p.status !== "management-approval") return;
 1594:   patchProposal(proposalId, (pp) => ({
 1595:     ...pp,
 1596:     status: "drafting",
 1597:     history: [
 1598:       ...pp.history,
 1599:       { at: nowIso(), byPersonId: person.id, action: "rejected", note },
 1600:     ],
 1601:   }));
 1602:   notify({ toPersonId: p.authorId, kind: "rejected", subjectId: p.subjectId, proposalId, agentFindings: note });
 1603:   set({ toast: "Rejected and returned to the author." });
 1604:   setAgent("evaluator", "done");
 1605: }
