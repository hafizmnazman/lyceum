    4: 
    5: import { useState, type ReactNode } from "react";
    6: 
    7: export function BrandImage({ name, alt, fallback, width, height, className }: { name: string; alt: string; fallback: ReactNode; width?: number | string; height?: number | string; className?: string }) {
    8:   const [failed, setFailed] = useState(false);
    9:   if (failed) return <>{fallback}</>;
   10:   return <img src={"/brand/" + name + ".png"} alt={alt} width={width} height={height} className={className} loading="lazy" onError={() => setFailed(true)} style={{ maxWidth: "100%", height: "auto" }} />;
   11: }
    1: // Runs the labelled scan benchmark through the real scan, and the live
    2: // self-checks over a workspace. Deterministic; the numbers are what they are.
    3: 
    4: import type { AppState } from "../app/store.ts";
    5: import { BENCHMARK_LEXICON, SCAN_BENCHMARK } from "../data/scanBenchmark.ts";
    6: import type { EvidenceSource } from "../types.ts";
    7: import { locateExcerpt, proposeMentions, skillKey } from "./evidence.ts";
    8: 
    9: export interface ScanBenchmarkResult {
   10:   sentences: number; goldMentions: number; proposed: number; truePositives: number; falsePositives: number; falseNegatives: number;
   11:   precision: number | null; recall: number | null; f1: number | null;
   12:   levelAccuracy: number | null; levelCorrect: number;
   13:   misses: Array<{ text: string; expected: string[]; got: string[] }>;
   14: }
   15: 
   16: export function runScanBenchmark(): ScanBenchmarkResult {
   17:   const sources: EvidenceSource[] = SCAN_BENCHMARK.map((s, i) => ({
   18:     id: "bench-" + i, subjectId: "BENCH", kind: "job-posting", title: "Sentence " + (i + 1), organisation: "Benchmark", url: "", sourceDate: "", text: s.text,
   19:     textHash: "bench", duplicateOf: null, provenance: "lecturer-supplied", reviewed: true, addedBy: "bench", addedAt: "2026-10-11T00:00:00Z",
   20:   }));
   21:   const proposals = proposeMentions(sources, BENCHMARK_LEXICON, []);
   22:   const gold = new Map<string, Set<string>>();
   23:   SCAN_BENCHMARK.forEach((s, i) => gold.set("bench-" + i, new Set(s.skills.map(skillKey))));
   24:   let tp = 0, fp = 0, levelCorrect = 0;
   25:   const got = new Map<string, Set<string>>();
   26:   for (const p of proposals) {
   27:     const key = skillKey(p.skill);
   28:     got.set(p.sourceId, (got.get(p.sourceId) ?? new Set()).add(key));
   29:     if (gold.get(p.sourceId)?.has(key)) {
   30:       tp += 1;
   31:       const index = Number(p.sourceId.slice(6));
   32:       if (SCAN_BENCHMARK[index].level === p.requirement) levelCorrect += 1;
   33:     } else fp += 1;
   34:   }
   35:   const goldMentions = SCAN_BENCHMARK.reduce((n, s) => n + s.skills.length, 0);
   36:   const fn = goldMentions - tp;
   37:   const precision = proposals.length ? tp / proposals.length : null, recall = goldMentions ? tp / goldMentions : null;
   38:   const f1 = precision !== null && recall !== null && precision + recall > 0 ? (2 * precision * recall) / (precision + recall) : null;
   39:   const misses = SCAN_BENCHMARK.map((s, i) => ({ text: s.text, expected: s.skills, got: [...(got.get("bench-" + i) ?? [])] }))
   40:     .filter((m) => m.expected.map(skillKey).sort().join("|") !== m.got.sort().join("|"));
   41:   return { sentences: SCAN_BENCHMARK.length, goldMentions, proposed: proposals.length, truePositives: tp, falsePositives: fp, falseNegatives: fn,
   42:     precision, recall, f1, levelAccuracy: tp ? levelCorrect / tp : null, levelCorrect, misses };
   43: }
   44: 
   45: export interface WorkspaceChecks {
   46:   quotations: number; verified: number; duplicates: number; reviewed: number; eligible: number; sourcesWithLinks: number; sources: number;
   47: }
   48: /** Live checks over what this browser holds: every quotation is re-verified against its source text right now. */
   49: export function workspaceChecks(state: AppState): WorkspaceChecks {
   50:   const sources = state.evidenceSources;
   51:   const byId = new Map(sources.map((s) => [s.id, s]));
   52:   let verified = 0;
   53:   for (const m of state.skillMentions) { const s = byId.get(m.sourceId); if (s && locateExcerpt(s.text, m.excerpt).ok) verified += 1; }
   54:   return {
   55:     quotations: state.skillMentions.length, verified, duplicates: sources.filter((s) => s.duplicateOf).length,
   56:     reviewed: sources.filter((s) => s.reviewed && !s.duplicateOf).length, eligible: sources.filter((s) => s.kind === "job-posting" && s.reviewed && !s.duplicateOf).length,
   57:     sourcesWithLinks: sources.filter((s) => s.url).length, sources: sources.length,
   58:   };
   59: }
