  35: /** The citation validator: the quotation must exist in the retained text. Only spacing may differ. */
  36: export function locateExcerpt(sourceText: string, excerpt: string): ExcerptLocation {
  37:   const quote = excerpt.trim();
  38:   if (!quote) return { ok: false, error: "Quote the exact requirement text from the source." };
  39:   const exact = sourceText.indexOf(quote);
  40:   if (exact >= 0) return { ok: true, match: "exact", start: exact, end: exact + quote.length };
  41:   const normalisedSource = normaliseWhitespace(sourceText), normalisedQuote = normaliseWhitespace(quote);
  42:   const loose = normalisedSource.indexOf(normalisedQuote);
  43:   if (loose >= 0) return { ok: true, match: "whitespace", start: loose, end: loose + normalisedQuote.length };
  44:   return { ok: false, error: "That excerpt was not found in the saved source text. Quote it exactly; only spacing differences are tolerated." };
  45: }
