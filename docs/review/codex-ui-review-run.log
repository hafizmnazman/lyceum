    1: // How Lyceum works: the seven roles as a pipeline, then the real step-by-step
    2: // record for the course you are working on. Every event on the timeline is
    3: // derived from something the workspace holds; nothing here is a fixture.
    4: 
    5: import { useState } from "react";
    6: import { BarChart3, BookOpen, ChevronDown, ChevronRight, Map as MapIcon, PenLine, Presentation, Search, ShieldCheck, type LucideIcon } from "lucide-react";
    7: import { ROLES, runTimeline, type RoleId } from "../../app/runs.ts";
    8: import { subjectsForPerson } from "../../app/roles.ts";
    9: import { currentPerson, navigate, selectStudioTab, selectSubject, useStore } from "../../app/store.ts";
   10: import { Button, Page, PageHead, Select, Tag } from "../primitives/index.tsx";
   11: 
   12: const ICONS: Record<RoleId, LucideIcon> = { folio: BookOpen, scout: Search, atlas: MapIcon, quill: PenLine, prism: Presentation, lens: BarChart3, steward: ShieldCheck };
   13: 
   14: export function OfficeScreen() {
   15:   const state = useStore();
   16:   const person = currentPerson();
   17:   const [open, setOpen] = useState<RoleId | null>(null);
   18:   if (!person) return null;
   19:   const mine = person.orgRole === "academic" ? subjectsForPerson(person.id, state.assignments) : state.subjects.map((s) => s.id);
   20:   const subjectId = state.selectedSubjectId && mine.includes(state.selectedSubjectId) ? state.selectedSubjectId : mine[0] ?? null;
   21:   const events = runTimeline(state, subjectId);
   22:   const roleName = (id: RoleId) => ROLES.find((r) => r.id === id)!;
   23:   return <Page wide>
   24:     <PageHead title="How Lyceum works" context="Seven roles, one afternoon, nothing automatic. Each role reads what you confirmed and hands the next one a record you can open." />
   25:     <ol className="pipeline" aria-label="The seven roles in order">
   26:       {ROLES.map((role) => { const Icon = ICONS[role.id]; const expanded = open === role.id; return <li key={role.id} className={expanded ? "is-open" : ""}>
   27:         <button type="button" className="pipeline-card" aria-expanded={expanded} onClick={() => setOpen(expanded ? null : role.id)} data-demo-id={"role-" + role.id}>
   28:           <span className="pipeline-icon" aria-hidden><Icon size={22} /></span>
   29:           <span className="pipeline-name">{role.name}</span>
   30:           <span className="pipeline-job">{role.job}</span>
   31:           <span className="pipeline-more" aria-hidden>{expanded ? <ChevronDown size={14} /> : <ChevronRight size={14} />}</span>
   32:         </button>
   33:         {expanded ? <dl className="pipeline-detail"><div><dt>Reads</dt><dd>{role.reads}</dd></div><div><dt>Produces</dt><dd>{role.produces}</dd></div><div><dt>Cannot</dt><dd>{role.cannot}</dd></div></dl> : null}
   34:       </li>; })}
   35:     </ol>
   36:     <div className="principle-strip" aria-label="Principles">
   37:       <div><strong>Only on request</strong><span>Nothing fetches or drafts until you ask.</span></div>
   38:       <div><strong>Exact quotations</strong><span>A requirement is a sentence from its source, or it is rejected.</span></div>
   39:       <div><strong>Denominator in view</strong><span>Counts over postings you reviewed, with an interval. No score.</span></div>
   40:       <div><strong>People decide</strong><span>Briefs go to colleagues; the university's process stays in charge.</span></div>
   41:     </div>
   42: 
   43:     <section className="workspace-panel" aria-labelledby="run-record">
   44:       <div className="section-heading"><div><h2 id="run-record">What actually happened{subjectId ? " on " + subjectId : ""}</h2><p className="muted">Every line below is derived from a record in this workspace, in the order it was created.</p></div>
   45:         {mine.length > 1 ? <label className="course-switcher">Course<Select aria-label="Choose course" value={subjectId ?? ""} onChange={(e) => selectSubject(e.target.value)}>{mine.map((id) => <option key={id} value={id}>{id}</option>)}</Select></label> : null}</div>
   46:       {events.length ? <ol className="timeline" data-demo-id="run-timeline">{events.map((e, i) => <li key={i}>
   47:         <span className="timeline-time num">{e.at.slice(0, 16).replace("T", " ")}</span>
   48:         <span className="timeline-role"><Tag tone="accent">{roleName(e.role).name}</Tag><span className="muted">{roleName(e.role).job}</span></span>
   49:         <div className="timeline-body"><strong>{e.title}</strong><p className="muted">{e.detail}</p></div>
   50:         {e.tab && subjectId ? <Button variant="quiet" aria-label={"Open " + e.title} onClick={() => { selectSubject(subjectId); selectStudioTab(e.tab!); navigate("studio"); }}>Open</Button> : null}
   51:       </li>)}</ol>
   52:         : <div className="empty-run"><p>No step has run on this course yet. Open the course and follow the journey bar, or press Play demo on the sign-in screen to watch one afternoon end to end.</p>
   53:           <Button variant="primary" onClick={() => navigate("courses")}>Open a course</Button></div>}
   54:     </section>
   55:     <p className="muted">Want to see how this is tested? <Button variant="quiet" onClick={() => navigate("evaluation")}>Open Evaluation</Button></p>
   56:   </Page>;
   57: }
    1: // Evaluation: how Lyceum is tested, what passes right now in this browser, the
    2: // labelled scan benchmark, and the protocol for the student-agent benchmark
    3: // against course outcomes and surveys. Numbers here are computed live or
    4: // quoted with their date; none is a projection.
    5: 
    6: import { useMemo } from "react";
    7: import { runScanBenchmark, workspaceChecks } from "../../lib/benchmark.ts";
    8: import { BENCHMARK_LEXICON } from "../../data/scanBenchmark.ts";
    9: import { parseWorkspaceBackup } from "../../lib/workspaceBackup.ts";
   10: import { exportWorkspaceBackup, navigate, useStore } from "../../app/store.ts";
   11: import { Button, Page, PageHead, Tag } from "../primitives/index.tsx";
   12: import { BarList } from "../primitives/ShareBar.tsx";
   13: 
   14: const SUITES: Array<[string, number, string]> = [
   15:   ["Acceptance scenario (illustrative spine)", 12, "canonical numbers of the synthetic scenario"],
   16:   ["Backtest (synthetic)", 4, "closed-loop arithmetic on synthetic data"],
   17:   ["Flow and roles", 28, "store, permissions, state machine"],
   18:   ["Signal reveal (fixture)", 12, "the staged fixture reveal"],
   19:   ["Intake parsing", 18, "xlsx, csv, pdf, pptx parse and interpret"],
   20:   ["Integrity", 13, "evidence edge cases, approval guards"],
   21:   ["Teaching plans", 10, "scope, validation, export"],
   22:   ["Curriculum", 28, "revisions, constraints, adoption, recovery"],
   23:   ["Evidence", 13, "citations, duplicates, Wilson intervals, mappings, backups"],
   24:   ["Collector", 6, "text extraction, cache, rate limits, timeouts"],
   25:   ["Research run", 5, "import on request, exact proposals, briefs"],
   26:   ["Slides", 3, "decks unzipped and read back"],
   27: ];
   28: 
   29: export function EvaluationScreen() {
   30:   const state = useStore();
   31:   const bench = useMemo(() => runScanBenchmark(), []);
   32:   const checks = workspaceChecks(state);
   33:   const backup = useMemo(() => parseWorkspaceBackup(exportWorkspaceBackup(), state.people.map((p) => p.id)), [state]);
   34:   const total = SUITES.reduce((n, s) => n + s[1], 0);
   35:   const pass = (ok: boolean) => <Tag tone={ok ? "ok" : "danger"}>{ok ? "Pass" : "Check"}</Tag>;
   36:   return <Page wide>
   37:     <PageHead title="Evaluation" context="How Lyceum is tested, what passes right now in this browser, and the benchmark we will run with real course data." />
   38: 
   39:     <section className="workspace-panel" aria-labelledby="live-checks">
   40:       <div className="section-heading"><div><h2 id="live-checks">Live checks on this workspace</h2><p className="muted">Recomputed every time this page renders, over the data in this browser.</p></div></div>
   41:       <div className="stat-grid">
   42:         <div className="stat-tile"><span className="stat-value">{checks.verified} of {checks.quotations}</span><span className="stat-label">stored quotations found verbatim in their source text right now</span>{pass(checks.verified === checks.quotations)}</div>
   43:         <div className="stat-tile"><span className="stat-value">{checks.duplicates}</span><span className="stat-label">duplicate copies detected by text fingerprint and counted once</span>{pass(true)}</div>
   44:         <div className="stat-tile"><span className="stat-value">{checks.eligible}</span><span className="stat-label">reviewed postings in the denominator, out of {checks.sources} sources</span>{pass(checks.eligible <= checks.sources)}</div>
   45:         <div className="stat-tile"><span className="stat-value">{backup.ok ? "Valid" : "Invalid"}</span><span className="stat-label">workspace backup re-validated: every record, link and quotation</span>{pass(backup.ok)}</div>
   46:       </div>
   47:     </section>
   48: 
   49:     <section className="workspace-panel" aria-labelledby="scan-bench">
   50:       <div className="section-heading"><div><h2 id="scan-bench">Requirement scan benchmark</h2><p className="muted">{bench.sentences} hand-labelled sentences in job-posting style, a fixed lexicon of {BENCHMARK_LEXICON.length} terms, scored against the deterministic scan. The lecturer still confirms every proposal; this measures how much help the scan gives.</p></div></div>
   51:       <BarList caption="Scan detection on the labelled set. Precision: proposals that were right. Recall: labelled skills that were found. Level accuracy: required or preferred read correctly among true positives." width={260} rows={[
   52:         { label: "Precision", share: bench.precision, note: bench.truePositives + " of " + bench.proposed },
   53:         { label: "Recall", share: bench.recall, note: bench.truePositives + " of " + bench.goldMentions },
   54:         { label: "F1", share: bench.f1 },
   55:         { label: "Level accuracy", share: bench.levelAccuracy, note: bench.levelCorrect + " of " + bench.truePositives },
   56:       ]} />
   57:       {bench.misses.length ? <details><summary>{bench.misses.length} sentences where the scan and the label disagree</summary><ul className="bench-misses">{bench.misses.map((m) => <li key={m.text}><span>{m.text}</span><span className="muted">expected {m.expected.join(", ") || "nothing"}; got {m.got.join(", ") || "nothing"}</span></li>)}</ul></details> : <p className="muted">The scan matches every label in this set.</p>}
   58:       <p className="muted">Limits: a small set written by one person; whole-word matching cannot find a skill named indirectly. Extend the set in <code>src/data/scanBenchmark.ts</code>; the proofs re-run it.</p>
   59:     </section>
   60: 
   61:     <section className="workspace-panel" aria-labelledby="suites">
   62:       <div className="section-heading"><div><h2 id="suites">Automated checks on the current code</h2><p className="muted">{total} checks across {SUITES.length} suites, plus four headless browser runs and the full-tour demo. Last run 11 October 2026. Reproduce with <code>npm run prove:all</code> and the smoke scripts.</p></div></div>
   63:       <div className="table-scroll"><table className="evidence-table"><thead><tr><th scope="col">Suite</th><th scope="col">Checks</th><th scope="col">Covers</th></tr></thead>
   64:         <tbody>{SUITES.map(([name, n, covers]) => <tr key={name}><th scope="row">{name}</th><td className="num">{n}</td><td>{covers}</td></tr>)}</tbody></table></div>
   65:     </section>
   66: 
   67:     <section className="workspace-panel" aria-labelledby="student-bench">
   68:       <div className="section-heading"><div><h2 id="student-bench">Student-agent benchmark: the protocol</h2><p className="muted">The earlier Cohort agent simulates learners to estimate the effect of a course change. Its numbers are not evidence until they are benchmarked against real outcomes. This is how we will do it.</p></div></div>
   69:       <ol className="protocol">
   70:         <li><strong>Ground truth.</strong> One course, one term: per-outcome attainment from the filed results (earned marks over available marks per CLO, with the allocation rules stated) and the CLO self-rating survey, kept separate from marks.</li>
   71:         <li><strong>Prediction before the term.</strong> The simulation's predicted mastery per CLO is frozen with the course version, cohort, term and model version, before results exist. Upload time is never teaching time.</li>
   72:         <li><strong>Scoring.</strong> Mean absolute error and calibration of predicted against actual attainment per CLO; correlation with the survey; a naive baseline (last term's attainment) that the model must beat.</li>
   73:         <li><strong>Transparency.</strong> Sample sizes, missingness and subgroup results reported; a learning-impact claim is made only after a held-out term, not from a fit.</li>
   74:       </ol>
   75:       <div className="stat-grid">
   76:         <div className="stat-tile"><span className="stat-value">0.009</span><span className="stat-label">mean absolute error of the simulation on its synthetic backtest. Synthetic data; not evidence of real accuracy.</span><Tag tone="warn">Synthetic</Tag></div>
   77:         <div className="stat-tile"><span className="stat-value">0</span><span className="stat-label">real terms benchmarked so far. The protocol needs one course and one term of results.</span><Tag tone="warn">Not yet run</Tag></div>
   78:       </div>
   79:       <p className="muted">Until that benchmark runs, the acceptance scenario stays in the research sandbox, labelled illustrative, and no learning gain is claimed anywhere in the product.</p>
   80:     </section>
   81: 
   82:     <section className="workspace-panel" aria-labelledby="pilot">
   83:       <div className="section-heading"><div><h2 id="pilot">Pilot measures with lecturers</h2></div></div>
   84:       <ul className="proof-list">
   85:         <li>Task completion without coaching, and time to an accepted brief.</li>
   86:         <li>Citation fidelity: zero fabricated quotations in a checked sample, by construction and by audit.</li>
   87:         <li>Educational alignment judged by a lecturer rubric; constraints never violated silently.</li>
   88:         <li>Repeat use next week and next term, and the actual cost per accepted pack.</li>
   89:       </ul>
   90:       <Button variant="quiet" onClick={() => navigate("office")}>Back to How Lyceum works</Button>
   91:     </section>
   92:   </Page>;
   93: }

 succeeded in 0ms:
    1: // Thin single-series bars for shares with a Wilson interval whisker. One hue
    2: // for magnitude, text in ink, the tooltip carries the exact numbers.
    3: 
    4: const pct = (x: number) => Math.round(x * 1000) / 10 + "%";
    5: 
    6: export function ShareBar({ share, low, high, width = 160 }: { share: number | null; low?: number | null; high?: number | null; width?: number }) {
    7:   if (share === null) return <span className="muted">Unknown</span>;
    8:   const h = 14, bar = 8, y = (h - bar) / 2;
    9:   const x = (v: number) => Math.round(v * (width - 2)) + 1;
   10:   const label = pct(share) + (typeof low === "number" && typeof high === "number" ? " (" + pct(low) + " to " + pct(high) + ")" : "");
   11:   return <svg className="share-bar" width={width} height={h} role="img" aria-label={label}><title>{label}</title>
   12:     <rect x={1} y={y} width={width - 2} height={bar} rx={2} fill="var(--surface-2)" />
   13:     {share > 0 ? <rect x={1} y={y} width={Math.max(2, x(share) - 1)} height={bar} rx={2} fill="var(--accent)" /> : null}
   14:     {typeof low === "number" && typeof high === "number" ? <>
   15:       <line x1={x(low)} x2={x(high)} y1={h / 2} y2={h / 2} stroke="var(--ink-3)" strokeWidth={2} />
   16:       <line x1={x(low)} x2={x(low)} y1={2} y2={h - 2} stroke="var(--ink-3)" strokeWidth={2} />
   17:       <line x1={x(high)} x2={x(high)} y1={2} y2={h - 2} stroke="var(--ink-3)" strokeWidth={2} />
   18:     </> : null}
   19:   </svg>;
   20: }
   21: 
   22: export interface BarRow { label: string; share: number | null; low?: number | null; high?: number | null; note?: string }
   23: /** A compact horizontal bar chart: labels left in ink, one accent hue, values right, no legend (one series). */
   24: export function BarList({ rows, caption, width = 240 }: { rows: BarRow[]; caption: string; width?: number }) {
   25:   return <figure className="bar-list" aria-label={caption}>
   26:     <div className="bar-list-rows">{rows.map((r) => <div className="bar-list-row" key={r.label}>
   27:       <span className="bar-list-label">{r.label}</span>
   28:       <ShareBar share={r.share} low={r.low} high={r.high} width={width} />
   29:       <span className="bar-list-value num">{r.share === null ? "Unknown" : pct(r.share)}{r.note ? <span className="muted"> {r.note}</span> : null}</span>
   30:     </div>)}</div>
   31:     <figcaption className="muted">{caption}</figcaption>
   32:   </figure>;
   33: }
    1: // Optional brand artwork: if public/brand/<name>.png exists (for example an
