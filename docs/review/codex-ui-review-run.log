 1287: export function reviewApprove(proposalId: ProposalId) {
 1288:   const proposal = proposalById(proposalId), person = currentPerson();
 1289:   if (!proposal || !person || proposal.status !== "coordinator-review" || !can(person, "review-draft", { subjectId: proposal.subjectId, assignments: state.assignments })) return;
 1290:   patchProposal(proposalId, (p) => ({
 1291:     ...p,
 1292:     status: "testing",
