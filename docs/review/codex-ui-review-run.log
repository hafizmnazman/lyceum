 1045: // ---------- the assessment studio (spec 6.4) ----------
 1046: const BLOOM_ORDER: BloomLevel[] = ["Remember", "Understand", "Apply", "Analyse", "Evaluate", "Create"];
 1047: // Display difficulty per Bloom level for generated items (the ladder shape the
 1048: // spine uses; labelled as a draft value until an item is calibrated).
 1049: const BLOOM_B: Record<BloomLevel, number> = {
 1050:   Remember: 0.1,
 1051:   Understand: 0.3,
 1052:   Apply: 0.5,
 1053:   Analyse: 0.7,
 1054:   Evaluate: 0.85,
 1055:   Create: 1.0,
 1056: };
 1057: const BLOOM_VERB: Record<BloomLevel, string> = {
 1058:   Remember: "Define",
 1059:   Understand: "Explain",
 1060:   Apply: "Apply",
 1061:   Analyse: "Analyse",
 1062:   Evaluate: "Evaluate",
 1063:   Create: "Design",
 1064: };
 1065: 
 1066: /** Create (or return the existing) test draft for a subject/proposal. */
 1067: export function createTestDraft(subjectId: SubjectId, proposalId?: ProposalId): string | null {
 1068:   const person = currentPerson();
 1069:   if (!person || !can(person,"draft-change",{ subjectId,assignments:state.assignments })) return null;
 1070:   const existing = state.testDrafts.find(
 1071:     (t) => t.subjectId === subjectId && t.status !== "approved" && (!proposalId || t.proposalId === proposalId),
 1072:   );
 1073:   if (existing) return existing.id;
 1074:   const clos = state.clos.filter((c) => c.subjectId === subjectId);
 1075:   const weight = clos.length > 0 ? 1 / clos.length : 1;
 1076:   const draft: TestDraft = {
 1077:     id: nextId(`TD-${subjectId}`),
 1078:     subjectId,
 1079:     proposalId,
 1080:     blueprint: {
 1081:       subjectId,
 1082:       totalMarks: 40,
 1083:       cloWeights: clos.map((c) => ({ cloId: c.id, weight })),
 1084:       bloomMix: { Understand: 0.25, Apply: 0.5, Analyse: 0.25 },
 1085:     },
 1086:     items: [],
 1087:     status: "drafting",
 1088:     authorId: person.id,
 1089:     courseVersionId: subjectById(subjectId)?.currentVersionId,
 1090:   };
 1091:   set((s) => ({ testDrafts: [...s.testDrafts, draft] }));
 1092:   if (proposalId) {
 1093:     patchProposal(proposalId, (p) => ({ ...p, draft: { ...p.draft, testDraftId: draft.id } }));
 1094:   }
 1095:   return draft.id;
 1096: }
 1097: 
 1098: 
 1099: function mayEditAssessment(t: TestDraft): boolean {
 1100:   const person = currentPerson();
 1101:   return !!person && can(person, "draft-change", { subjectId: t.subjectId, assignments: state.assignments }) &&
 1102:     (t.authorId === person.id || can(person, "review-draft", { subjectId: t.subjectId, assignments: state.assignments }));
 1103: }
 1104: 
 1105: function assessmentLinkError(t: TestDraft): string | null {
 1106:   const ids = new Set(state.clos.filter(c => c.subjectId === t.subjectId).map(c => c.id));
 1107:   return t.blueprint.cloWeights.some(w => !ids.has(w.cloId)) || t.items.some(i => !ids.has(i.targetCLO))
 1108:     ? "Repair removed outcome links before reviewing this assessment." : null;
 1109: }
 1110: 
 1111: /** Keep the questions; explicitly replace obsolete blueprint mappings. */
 1112: export function resetAssessmentOutcomeWeights(testDraftId: string) {
 1113:   const t = state.testDrafts.find(x => x.id === testDraftId);
 1114:   if (!t || !mayEditAssessment(t)) return;
 1115:   const clos = state.clos.filter(c => c.subjectId === t.subjectId);
 1116:   if (!clos.length) { set({ toast: "Record course outcomes before resetting the blueprint." }); return; }
 1117:   set(s => ({ testDrafts: s.testDrafts.map(x => x.id === t.id ? { ...x, status: "drafting",
 1118:     needsReview: true, blueprint: { ...x.blueprint, cloWeights: clos.map(c => ({ cloId: c.id, weight: 1 / clos.length })) } } : x),
 1119:     toast: "Outcome weights reset. Questions were kept; review their mappings and marks." }));
 1120: }
 1121: 
 1122: export function acknowledgeAssessmentCourseChange(testDraftId: string, acknowledged: boolean) {
 1123:   const t = state.testDrafts.find(x => x.id === testDraftId);
 1124:   if (!t || !mayEditAssessment(t)) return { ok: false, error: "Only the assessment author or course coordinator can record this review." };
 1125:   if (!acknowledged) return { ok: false, error: "Review the blueprint and every question before recording the course-change review." };
 1126:   const error = assessmentLinkError(t);
 1127:   if (error) return { ok: false, error };
 1128:   if (!t.items.length) return { ok: false, error: "Prepare and review the questions first." };
 1129:   set(s => ({ testDrafts: s.testDrafts.map(x => x.id === t.id ? { ...x, status: "drafting",
 1130:     needsReview: false, courseVersionId: subjectById(t.subjectId)?.currentVersionId } : x),
 1131:     toast: "Course-change review recorded. Send the assessment through its normal review step." }));
 1132:   return { ok: true };
 1133: }
 1134: 
 1135: export function updateBlueprint(testDraftId: string, blueprint: AssessmentBlueprint) {
 1136:   const t = state.testDrafts.find(x => x.id === testDraftId);
 1137:   if (!t || !mayEditAssessment(t)) return;
 1138:   set((s) => ({
 1139:     testDrafts: s.testDrafts.map((t) => (t.id === testDraftId ? { ...t, blueprint, status: "drafting" } : t)),
 1140:   }));
 1141: }
 1142: 
 1143: /** Deterministic local item generation against the blueprint (the offline path;
 1144:  *  the live Authoring agent replaces the wording, not the structure). */
 1145: export function generateTestItems(testDraftId: string) {
 1146:   const t = state.testDrafts.find((x) => x.id === testDraftId);
 1147:   if (!t || !mayEditAssessment(t)) return;
 1148:   const clos = state.clos.filter((c) => c.subjectId === t.subjectId);
 1149:   const targetCount = Math.max(4, Math.round(t.blueprint.totalMarks / 5));
 1150:   const mix = Object.entries(t.blueprint.bloomMix) as Array<[BloomLevel, number]>;
 1151:   const bloomPool: BloomLevel[] = [];
 1152:   for (const [level, share] of mix) {
 1153:     const n = Math.max(1, Math.round(share * targetCount));
 1154:     for (let i = 0; i < n; i += 1) bloomPool.push(level);
 1155:   }
 1156:   while (bloomPool.length < targetCount) bloomPool.push("Apply");
 1157:   bloomPool.sort((a, b) => BLOOM_ORDER.indexOf(a) - BLOOM_ORDER.indexOf(b));
 1158: 
 1159:   const items: TestItem[] = [];
 1160:   let i = 0;
 1161:   for (const cw of t.blueprint.cloWeights) {
 1162:     const clo = clos.find((c) => c.id === cw.cloId);
 1163:     if (!clo) continue;
 1164:     const count = Math.max(1, Math.round(cw.weight * targetCount));
 1165:     for (let k = 0; k < count && items.length < targetCount; k += 1) {
 1166:       const bloom = bloomPool[Math.min(i, bloomPool.length - 1)];
 1167:       i += 1;
 1168:       items.push({
 1169:         id: `${t.id}-Q${items.length + 1}`,
 1170:         text: `${BLOOM_VERB[bloom]} ${clo.text.toLowerCase()} ${
 1171:           bloom === "Apply" || bloom === "Analyse"
 1172:             ? "on a worked scenario, showing each step"
 1173:             : "in your own words, with one concrete example"
 1174:         }.`,
 1175:         targetCLO: clo.id,
 1176:         bloomLevel: bloom,
 1177:         difficulty: BLOOM_B[bloom],
 1178:         marks: Math.max(2, Math.round((cw.weight * t.blueprint.totalMarks) / count)),
 1179:         source: "agent",
 1180:       });
 1181:     }
 1182:   }
 1183:   set((s) => ({
 1184:     testDrafts: s.testDrafts.map((x) => (x.id === testDraftId ? { ...x, items, status: "drafting" } : x)),
 1185:     toast: `Drafted ${items.length} items against the blueprint.`,
 1186:   }));
 1187: }
 1188: 
 1189: export function updateTestItem(testDraftId: string, itemId: string, patch: Partial<TestItem>) {
 1190:   const draft = state.testDrafts.find(x => x.id === testDraftId);
 1191:   if (!draft || !mayEditAssessment(draft)) return;
 1192:   set((s) => ({
 1193:     testDrafts: s.testDrafts.map((t) =>
 1194:       t.id === testDraftId
 1195:         ? {
 1196:             ...t, status: "drafting",
 1197:             items: t.items.map((it) =>
 1198:               it.id === itemId ? { ...it, ...patch, source: "human" as const } : it,
 1199:             ),
 1200:           }
 1201:         : t,
 1202:     ),
 1203:   }));
 1204: }
 1205: 
 1206: export function removeTestItem(testDraftId: string, itemId: string) {
 1207:   const draft = state.testDrafts.find(x => x.id === testDraftId);
 1208:   if (!draft || !mayEditAssessment(draft)) return;
 1209:   set((s) => ({
 1210:     testDrafts: s.testDrafts.map((t) =>
 1211:       t.id === testDraftId ? { ...t, status: "drafting", items: t.items.filter((it) => it.id !== itemId) } : t,
 1212:     ),
 1213:   }));
 1214: }
