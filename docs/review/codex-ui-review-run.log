  632: // ---------- Trends -> routing (spec Section 7) ----------
  633: export function routeDrift(subjectId: SubjectId) {
  634:   const signal = runSignal(state.programme.id);
  635:   setAgent("signal", "done");
  636:   setAgent("curriculum", "done");
  637:   const drift = signal.subjectDrift.find((d) => d.subjectId === subjectId);
  638:   const rating = ratingFor(subjectId);
  639:   const sources = rating
  640:     ? new Set(rating.evidence.map((e) => e.sourceId)).size
  641:     : 0;
  642:   const findings =
  643:     `Demand on this subject's outcomes is outpacing coverage (gap ${(drift?.gap ?? 0).toFixed(2)}` +
  644:     (sources > 0 ? `, corroborated across ${sources} market sources` : "") +
  645:     `). Sampled from the skills signal over the programme.`;
  646:   if (drift?.flag === "new-subject") {
  647:     notify({
  648:       toPersonId: state.programme.departmentOwnerId,
  649:       kind: "ping-new-subject",
  650:       subjectId,
  651:       agentFindings: findings,
  652:     });
  653:     set({ toast: "Routed to the department owner to scope a new subject." });
  654:   } else {
  655:     const coord = personWithHat(subjectId, "coordinator");
  656:     const proposal = state.proposals.find((p) => p.subjectId === subjectId);
  657:     if (coord) {
  658:       notify({
  659:         toPersonId: coord.id,
  660:         kind: "ping-update",
  661:         subjectId,
  662:         proposalId: proposal?.id,
  663:         agentFindings: findings,
  664:       });
  665:       set({ toast: `Routed to ${coord.name}, the subject coordinator.` });
  666:     }
  667:   }
  668: }
  669: 
  670: // ---------- Trends -> the staged Signal reveal ----------
  671: let signalTimer: ReturnType<typeof setInterval> | null = null;
  672: 
  673: /** Play the Signal agent's staged reveal on the Trends screen: reading ->
  674:  *  extracting -> mapping -> done, landing on CS220 / CLO4 gap 0.62.
  675:  *  Deterministic, fixed ticks. Idempotent while running. */
  676: export function runSignalReveal() {
  677:   if (state.signalSim && state.signalSim.phase !== "done") return;
  678:   setAgent("signal", "working");
  679:   set({ signalSim: initSignalSim() });
  680:   if (signalTimer) clearInterval(signalTimer);
  681:   signalTimer = setInterval(tickSignal, scaleMs(SIGNAL_TICK_MS));
  682: }
  683: 
  684: function tickSignal() {
  685:   const ss = state.signalSim;
  686:   if (!ss) {
  687:     if (signalTimer) clearInterval(signalTimer);
  688:     signalTimer = null;
  689:     return;
  690:   }
  691:   const next = stepSignal(ss);
  692:   set({ signalSim: next });
  693:   if (next.phase === "done") {
  694:     if (signalTimer) clearInterval(signalTimer);
  695:     signalTimer = null;
  696:     setAgent("signal", "done");
  697:     setAgent("curriculum", "done");
  698:   }
  699: }
  700: 
  701: /** Clear the reveal so a fresh demo run replays it from the top. */
  702: export function resetSignalReveal() {
  703:   if (signalTimer) clearInterval(signalTimer);
  704:   signalTimer = null;
  705:   set({ signalSim: null });
  706: }
  707: 
  708: // ---------- the real intake pipeline (parse -> interpret -> confirm) ----------
  709: /** Stage an interpreted upload for the user to confirm. The preview-and-confirm
  710:  *  step is the trust boundary: nothing files until a human has seen what the
  711:  *  agent read and what it made of it. */
  712: export function stagePendingIntake(doc: ParsedDoc, interp: IntakeInterpretation) {
  713:   set({ pendingIntake: { doc, interp } });
  714: }
  715: export function clearPendingIntake() {
  716:   set({ pendingIntake: null });
  717: }
  718: 
  719: /** File the confirmed interpretation into the spine. Returns what was filed. */
  720: export function confirmPendingIntake(): string | null {
  721:   const pending = state.pendingIntake;
  722:   const person = currentPerson();
  723:   if (!pending || !person) return null;
  724:   const { doc, interp } = pending;
  725:   const subjectId = interp.subjectGuess;
  726:   const term = interp.termGuess ?? TERM;
  727:   const at = nowIso();
  728:   const involved = interp.docType === "clo-survey" ? [...new Set((interp.surveyRecords ?? []).map(r => r.subjectId))] : subjectId ? [subjectId] : [];
  729:   if (involved.some(id => !subjectById(id) || !can(person, "upload-results", { subjectId: id, assignments: state.assignments }))) {
  730:     set({ toast: "You can only file records for your assigned courses. Correct the course selection." }); return null;
  731:   }
  732: 
  733:   if (interp.docType === "results" && subjectId && interp.mappedRows?.length) {
  734:     const upload: ResultUpload = {
  735:       id: nextId(`RU-${subjectId}`),
  736:       subjectId,
  737:       uploadedBy: person.id,
  738:       term,
  739:       rows: interp.mappedRows,
  740:       filedAt: at,
  741:       sourceFileName: doc.fileName,
  742:     };
  743:     const ds: DataSource = {
  744:       kind: "results",
  745:       subjectId,
  746:       term,
  747:       recordCount: upload.rows.reduce((m, r) => Math.max(m, r.n), 0),
  748:       ingestedAt: at,
  749:       verified: false,
  750:       sourceFileName: doc.fileName,
  751:     };
  752:     set((s) => ({
  753:       resultUploads: [...s.resultUploads, upload],
  754:       dataSources: [ds, ...s.dataSources],
  755:       flashUpload: upload,
  756:       pendingIntake: null,
  757:       toast: `Filed ${doc.fileName} to ${subjectId}, ${term}. This ground now feeds the cohort.`,
  758:     }));
  759:     fillPredictionsForSubject(subjectId);
  760:     return upload.id;
  761:   }
  762: 
  763:   if (interp.docType === "clo-survey" && interp.surveyRecords?.length) {
  764:     const records = interp.surveyRecords;
  765:     const bySubject = new Map<string, number>();
  766:     for (const r of records) {
  767:       bySubject.set(r.subjectId, (bySubject.get(r.subjectId) ?? 0) + 1);
  768:     }
  769:     const sources: DataSource[] = [...bySubject.entries()].map(([sid, count]) => ({
  770:       kind: "clo-survey",
  771:       subjectId: sid,
  772:       term,
  773:       recordCount: count,
  774:       ingestedAt: at,
  775:       verified: false,
  776:       sourceFileName: doc.fileName,
  777:     }));
  778:     set((s) => ({
  779:       survey: [...s.survey, ...records],
  780:       dataSources: [...sources, ...s.dataSources],
  781:       pendingIntake: null,
  782:       toast: `Filed ${records.length} survey records from ${doc.fileName}.`,
  783:     }));
  784:     return `${records.length} records`;
  785:   }
  786: 
  787:   if ((interp.docType === "syllabus" || interp.docType === "slides") && subjectId) {
  788:     const ds: DataSource = {
  789:       kind: interp.docType === "syllabus" ? "syllabus" : "material",
  790:       subjectId,
  791:       term,
  792:       recordCount: doc.pages.length,
  793:       ingestedAt: at,
  794:       verified: false,
  795:       sourceFileName: doc.fileName,
  796:     };
  797:     set((s) => ({
  798:       dataSources: [ds, ...s.dataSources],
  799:       subjects:
  800:         interp.docType === "syllabus"
  801:           ? s.subjects.map((su) =>
  802:               su.id === subjectId ? { ...su, syllabusVerifiedAt: undefined, syllabusSourceUrl: doc.fileName } : su,
  803:             )
  804:           : s.subjects,
  805:       pendingIntake: null,
  806:       toast: `Filed ${doc.fileName} as ${interp.docType === "syllabus" ? "a reviewed syllabus upload" : "course material"} for ${subjectId}.`,
  807:     }));
  808:     return ds.sourceFileName ?? null;
  809:   }
  810: 
  811:   set({ toast: "Nothing was filed: the interpretation had no usable content.", pendingIntake: null });
  812:   return null;
  813: }
  814: 
  815: // ---------- Upload (the v2 one-click fixture path, kept for demo + proofs) ----------
  816: const DEMO_SHEET: ParsedSheet = {
  817:   fileName: "CS220-results-2025-S1.xlsx",
  818:   headers: ["student", "CLO4 score"],
  819:   rows: [
  820:     { student: "anon-1", "CLO4 score": 0.55 },
  821:     { student: "anon-2", "CLO4 score": 0.6 },
  822:   ],
  823: };
  824: 
  825: export function uploadResults(subjectId: SubjectId) {
  826:   const person = currentPerson();
  827:   if (!person) return;
  828:   setAgent("intake", "working");
  829:   const upload = runIntake(DEMO_SHEET, subjectId, {
  830:     uploadedBy: person.id,
  831:     term: TERM,
  832:     filedAt: SEED_NOW,
  833:     uploadId: `RU-${subjectId}-${TERM}`,
  834:   });
  835:   set((s) => {
  836:     const others = s.resultUploads.filter((u) => u.id !== upload.id);
  837:     const ds: DataSource = {
  838:       kind: "results",
  839:       subjectId,
  840:       term: TERM,
  841:       recordCount: upload.rows.reduce((m, r) => Math.max(m, r.n), 0),
  842:       ingestedAt: SEED_NOW,
  843:       verified: true,
  844:     };
  845:     const dataSources = [
  846:       ds,
  847:       ...s.dataSources.filter(
  848:         (d) => !(d.kind === "results" && d.subjectId === subjectId && d.term === TERM),
  849:       ),
  850:     ];
  851:     return { resultUploads: [...others, upload], dataSources, flashUpload: upload };
  852:   });
  853:   setAgent("intake", "done");
  854:   fillPredictionsForSubject(subjectId);
  855: }
  856: 
  857: function masteryFromUpload(u: ResultUpload): number {
  858:   if (u.rows.length === 0) return 0;
  859:   return u.rows.reduce((sum, r) => sum + r.meanScore, 0) / u.rows.length;
  860: }
  861: 
  862: /** The latest results upload for a subject filed AT OR AFTER a moment. A
  863:  *  prediction is a claim about the change taking effect, so it is only scored by
  864:  *  results that arrived after it was made, never by what was already on file. */
  865: function latestUploadSince(subjectId: SubjectId, since: string): ResultUpload | undefined {
  866:   return [...state.resultUploads]
  867:     .filter((u) => u.subjectId === subjectId && u.filedAt >= since)
  868:     .sort((a, b) => (a.filedAt < b.filedAt ? 1 : -1))[0];
  869: }
  870: 
  871: /** Closed loop: score any open prediction on a subject against results filed
  872:  *  after the prediction was made. Returns how many were scored. */
  873: function fillPredictionsForSubject(subjectId: SubjectId): number {
  874:   let scored = 0;
  875:   set((s) => ({
  876:     predictions: s.predictions.map((p) => {
  877:       if (p.subjectId !== subjectId || p.actualMastery !== undefined) return p;
  878:       const upload = latestUploadSince(subjectId, p.madeAt);
  879:       if (!upload) return p;
  880:       const actual = masteryFromUpload(upload);
  881:       scored += 1;
  882:       return { ...p, actualMastery: actual, residual: Math.abs(p.predictedMastery - actual) };
  883:     }),
  884:   }));
  885:   return scored;
  886: }
  887: 
  888: /** Score every open prediction against results filed since it was made. Honest
  889:  *  toast: only claims what it actually did. */
  890: export function scoreOpenPredictions() {
  891:   let scored = 0;
  892:   for (const subjectId of new Set(
  893:     state.predictions.filter((p) => p.actualMastery === undefined).map((p) => p.subjectId),
  894:   )) {
  895:     scored += fillPredictionsForSubject(subjectId);
  896:   }
  897:   set({
  898:     toast:
  899:       scored > 0
  900:         ? `Scored ${scored} prediction${scored === 1 ? "" : "s"} against the filed results.`
  901:         : "No new results have been filed since these predictions were made.",
  902:   });
  903: }
  904: 
  905: // ---------- Course Studio: authoring ----------
  906: export function draftWithAgent(proposalId: ProposalId, mode: "agent" | "hybrid") {
  907:   const p = proposalById(proposalId);
  908:   const subject = p && subjectById(p.subjectId);
  909:   if (!p || !subject) return;
  910:   setAgent("authoring", "working");
  911:   const clos = state.clos.filter((c) => c.subjectId === subject.id);
  912:   const result = runAuthoring(subject, clos, "Align with demand", "draft", p.draft, "fixture");
  913:   patchProposal(proposalId, (pp) => ({
  914:     ...pp,
  915:     draft: { ...result.draft, testDraftId: pp.draft.testDraftId },
  916:     history: [
  917:       ...pp.history,
  918:       { at: nowIso(), byPersonId: pp.authorId, action: "agent-drafted", note: `Agent drafted (${mode} mode).` },
  919:     ],
  920:   }));
  921:   setAgent("authoring", mode === "hybrid" ? "needs-input" : "done");
  922:   if (mode === "hybrid") {
  923:     set({ agentBubble: { agent: "authoring", text: "Drafted a revision. Your turn to refine a line." } });
  924:   }
  925:   augmentLive("authoring", `Drafting an update for ${subject.id} against rising demand`, "studio", {
  926:     job: "draft",
  927:     subject: { id: subject.id, title: subject.title },
  928:     clos: clos.map((c) => ({ id: c.id, text: c.text, bloomLevel: c.bloomLevel })),
  929:     target: "Align the subject with rising market demand for machine learning",
  930:     mode,
  931:   });
  932: }
  933: 
  934: /** Replace a proposal's draft wholesale (the live Authoring path streams, then
  935:  *  commits through here so history stays honest about who wrote what). */
  936: export function applyAgentDraft(proposalId: ProposalId, draft: ChangeProposal["draft"], note: string) {
  937:   patchProposal(proposalId, (pp) => ({
  938:     ...pp,
  939:     draft: { ...draft, testDraftId: pp.draft.testDraftId },
  940:     history: [...pp.history, { at: nowIso(), byPersonId: pp.authorId, action: "agent-drafted", note }],
  941:   }));
  942: }
  943: 
  944: export function requestAgentReview(proposalId: ProposalId) {
  945:   const p = proposalById(proposalId);
  946:   const subject = p && subjectById(p.subjectId);
  947:   if (!p || !subject) return;
  948:   setAgent("authoring", "working");
  949:   const clos = state.clos.filter((c) => c.subjectId === subject.id);
  950:   const result = runAuthoring(subject, clos, "Review draft", "review", p.draft, "fixture");
  951:   set({ critique: result.critique ?? [] });
  952:   setAgent("authoring", "needs-input");
  953:   set({ agentBubble: { agent: "authoring", text: "I flagged a few things in the draft." } });
  954:   // Live path: a real model critique replaces the fixture lines when it lands.
  955:   augmentLive(
  956:     "authoring",
  957:     `Reviewing the ${subject.id} draft`,
  958:     "studio",
  959:     {
  960:       job: "review",
  961:       subject: { id: subject.id, title: subject.title },
  962:       clos: clos.map((c) => ({ id: c.id, text: c.text, bloomLevel: c.bloomLevel })),
  963:       draft: p.draft,
  964:     },
  965:     (text) => {
  966:       const lines = text
  967:         .split("\n")
  968:         .map((l) => l.replace(/^[-*\d.\s]+/, "").trim())
  969:         .filter((l) => l.length > 8)
  970:         .slice(0, 6);
  971:       if (lines.length > 0) set({ critique: lines });
  972:     },
  973:   );
  974: }
  975: 
  976: export function setCritique(critique: string[] | null) {
  977:   set({ critique });
  978: }
