  462: // ---------- agent presence (spec 5.7) ----------
  463: export function beginAgentRun(agent: AgentId, label: string, onPage: string): string {
  464:   const id = nextId("AR");
  465:   const run: AgentRun = {
  466:     id,
  467:     agent,
  468:     status: "thinking",
  469:     startedAt: nowIso(),
  470:     label,
  471:     streamText: "",
  472:     onPage,
  473:   };
  474:   setAgent(agent, "working");
  475:   set((s) => ({ agentRuns: [...s.agentRuns.slice(-19), run] }));
  476:   return id;
  477: }
  478: export function appendAgentStream(runId: string, chunk: string) {
  479:   set((s) => ({
  480:     agentRuns: s.agentRuns.map((r) =>
  481:       r.id === runId ? { ...r, status: "streaming", streamText: (r.streamText ?? "") + chunk } : r,
  482:     ),
  483:   }));
  484: }
  485: export function finishAgentRun(
  486:   runId: string,
  487:   status: "done" | "failed" | "fallback",
  488:   opts?: { label?: string; resultRef?: string },
  489: ) {
  490:   const run = state.agentRuns.find((r) => r.id === runId);
  491:   if (run) setAgent(run.agent, "done");
  492:   set((s) => ({
  493:     agentRuns: s.agentRuns.map((r) =>
  494:       r.id === runId
  495:         ? { ...r, status, label: opts?.label ?? r.label, resultRef: opts?.resultRef }
  496:         : r,
  497:     ),
  498:   }));
  499: }
  500: export function latestRunFor(agent: AgentId): AgentRun | undefined {
  501:   return [...state.agentRuns].reverse().find((r) => r.agent === agent);
  502: }
  503: 
  504: /** Fire a live agent stream in the background. The deterministic path never
  505:  *  depends on it: the fixture result is applied first and stands either way;
  506:  *  the live stream augments it (visible model output in the strip and panel,
  507:  *  and optionally a richer text result via onText). Skipped in Node and while
  508:  *  the clock is pinned, so proofs and the recorded demo stay identical. */
  509: function augmentLive(
  510:   agent: "authoring" | "evaluator",
  511:   label: string,
  512:   onPage: string,
  513:   payload: unknown,
  514:   onText?: (text: string) => void,
  515: ) {
  516:   if (typeof window === "undefined" || clockPinned) return;
  517:   const runId = beginAgentRun(agent, label, onPage);
  518:   void streamAgent(agent, payload, (chunk) => appendAgentStream(runId, chunk)).then((text) => {
  519:     if (text) {
  520:       finishAgentRun(runId, "done", { label });
  521:       onText?.(text);
  522:     } else {
  523:       finishAgentRun(runId, "fallback", { label: `${label} (offline draft used)` });
  524:     }
  525:   });
  526: }
  527: export function toggleAgentPanel(open?: boolean) {
  528:   set((s) => ({ agentPanelOpen: open ?? !s.agentPanelOpen }));
  529: }
