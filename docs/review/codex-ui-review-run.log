    1: // The lecturer's journey, computed from real state so the guide never lies:
    2: // a step is done when the workspace holds the thing it produces.
    3: 
    4: import type { AppState } from "./store.ts";
    5: import type { Screen } from "./roles.ts";
    6: 
    7: export interface JourneyStep {
    8:   id: string;
    9:   title: string; // two or three words
   10:   help: string; // one sentence: what to do
   11:   done: boolean;
   12:   count: string; // what exists, for example "3 sources"
   13:   screen: Screen;
   14:   tab?: AppState["studioTab"];
   15: }
   16: 
   17: export function journeyFor(state: AppState, subjectId: string | null): JourneyStep[] {
   18:   const id = subjectId ?? "";
   19:   const definition = id ? state.courseDefinitions[id] : undefined;
   20:   const adopted = state.curriculumDrafts.some((d) => d.subjectId === id && d.status === "adopted");
   21:   const sources = state.evidenceSources.filter((s) => s.subjectId === id);
   22:   const reviewed = sources.filter((s) => s.reviewed && !s.duplicateOf);
   23:   const mentions = state.skillMentions.filter((m) => m.subjectId === id);
   24:   const mappings = state.skillMappings.filter((m) => m.subjectId === id);
   25:   const sessions = state.teachingPlans.find((p) => p.subjectId === id)?.sessions ?? [];
   26:   const briefs = state.evidenceBriefs.filter((b) => b.subjectId === id);
   27:   const outcomes = state.clos.filter((c) => c.subjectId === id);
   28:   return [
   29:     { id: "course", title: "Open a course", help: "Pick an assigned course or create a personal workspace.", done: Boolean(id), count: id || "none yet", screen: "courses" },
   30:     { id: "outline", title: "Confirm the outline", help: "Start a revision, check the outcomes and topics against the hours, and adopt the version.",
   31:       done: adopted || (definition?.topics.length ?? 0) > 0, count: outcomes.length + " outcomes, " + (definition?.topics.length ?? 0) + " topics", screen: "studio", tab: "curriculum" },
   32:     { id: "collect", title: "Collect evidence", help: "Fetch postings from an employer board and keep the ones worth reading.", done: sources.length > 0,
   33:       count: sources.length + " sources", screen: "studio", tab: "evidence" },
   34:     { id: "confirm", title: "Confirm quotations", help: "Scan for the skills you name, confirm each exact quotation, mark the postings reviewed.",
   35:       done: mentions.length > 0 && reviewed.length > 0, count: mentions.length + " quotations, " + reviewed.length + " reviewed", screen: "studio", tab: "evidence" },
   36:     { id: "map", title: "Map to outcomes", help: "Say what the course does about each skill today and what it should reach.", done: mappings.length > 0,
   37:       count: mappings.length + " mapped", screen: "studio", tab: "evidence" },
   38:     { id: "plan", title: "Plan a class", help: "Save a session linked to an outcome and download its teaching pack.", done: sessions.length > 0,
   39:       count: sessions.length + " sessions", screen: "studio", tab: "plan" },
   40:     { id: "brief", title: "Brief the meeting", help: "Prepare the brief, download it as slides, or send it to a colleague.", done: briefs.length > 0,
   41:       count: briefs.filter((b) => b.sentAt).length + " sent of " + briefs.length, screen: "studio", tab: "evidence" },
   42:   ];
   43: }
   44: 
   45: export function nextJourneyStep(steps: JourneyStep[]): JourneyStep | null {
   46:   return steps.find((s) => !s.done) ?? null;
   47: }
