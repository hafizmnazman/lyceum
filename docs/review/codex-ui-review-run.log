  35: export function DemoOverlay() {
  36:   const state = useStore();
  37:   const [phase, setPhase] = useState<Phase>("idle");
  38:   const [card, setCard] = useState(0);
  39:   const [caption, setCaption] = useState("");
  40:   const [cursor, setCursor] = useState({ x: -100, y: -100 });
  41:   const [startedAt, setStartedAt] = useState(0);
  42:   const [now, setNow] = useState(0);
  43:   const [muted, setMuted] = useState(false);
  44:   const abortRef = useRef(false);
  45:   const playRef = useRef<() => Promise<void>>(async () => {});
  46: 
  47:   // Escape aborts a running demo.
  48:   useEffect(() => {
  49:     function onKey(e: KeyboardEvent) {
  50:       if (e.key === "Escape") abortRef.current = true;
  51:     }
  52:     window.addEventListener("keydown", onKey);
  53:     return () => window.removeEventListener("keydown", onKey);
  54:   }, []);
  55: 
  56:   // The landing page's "Watch the tour" button asks the overlay to play.
  57:   useEffect(() => {
  58:     function onPlay() { void playRef.current(); }
  59:     window.addEventListener("lyceum:play-demo", onPlay);
  60:     return () => window.removeEventListener("lyceum:play-demo", onPlay);
  61:   }, []);
  62: 
  63:   // Progress clock while playing.
  64:   useEffect(() => {
  65:     if (phase === "idle" || phase === "done") return;
  66:     const t = setInterval(() => setNow(performance.now()), 250);
  67:     return () => clearInterval(t);
  68:   }, [phase]);
  69: 
  70:   async function play() {
  71:     const hasSavedWork = state.teachingPlans.length > 0 || state.testDrafts.length > 0
  72:       || JSON.stringify(state.proposals) !== JSON.stringify([CANONICAL_PROPOSAL])
  73:       || JSON.stringify(state.assignments) !== JSON.stringify(ROLE_ASSIGNMENTS)
  74:       || state.dataSources.some((source) => source.sourceFileName);
  75:     if (hasSavedWork && !window.confirm("Playing the demo resets this browser's workspace, including saved plans, drafts and uploads. Export any plan you want to keep first. Continue?")) return;
  76:     abortRef.current = false;
  77:     setClockPinned(true);
  78:     resetDemoState();
  79:     resetSignalReveal();
  80:     demoAudio.start(muted); // inside the click gesture, so autoplay allows it
  81:     setStartedAt(performance.now());
  82:     setPhase("intro");
  83:     for (let i = 0; i < INTRO_CARDS.length; i += 1) {
  84:       if (abortRef.current) return stop();
  85:       setCard(i);
  86:       await new Promise((r) => setTimeout(r, scaleMs(INTRO_HOLDS[i] ?? 6000)));
  87:     }
  88:     if (abortRef.current) return stop();
  89:     setPhase("walkthrough");
  90:     await runDemo({
  91:       setCaption,
  92:       setCursor: (x, y) => setCursor({ x, y }),
  93:       shouldAbort: () => abortRef.current,
  94:     });
  95:     if (abortRef.current) return stop();
  96:     setPhase("done");
  97:     setCaption("");
  98:     setTimeout(() => stop(), 6000);
  99:   }
 100: 
 101:   playRef.current = play;
