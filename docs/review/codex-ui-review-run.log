  989: /** Edit the free-text parts of a draft (topics, test/lab notes). */
  990: export function editDraftField(
  991:   proposalId: ProposalId,
  992:   field: "topics" | "testDraft" | "labDraft",
  993:   value: string,
  994: ) {
  995:   patchProposal(proposalId, (p) => ({
  996:     ...p,
  997:     draft: {
  998:       ...p.draft,
  999:       [field]: field === "topics" ? value.split("\n").filter((t) => t.trim().length > 0) : value,
 1000:     },
