  410: // ---------- lecturer preparation (browser-local, separate from proposals) ----------
  411: function mayPlan(subjectId: SubjectId): boolean {
  412:   const person = currentPerson();
  413:   return !!person && !!subjectById(subjectId) && can(person, "draft-change", { subjectId, assignments: state.assignments });
  414: }
