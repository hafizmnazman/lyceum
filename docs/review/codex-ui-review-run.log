  576: // ---------- notifications ----------
  577: function notify(args: {
  578:   toPersonId: PersonId;
  579:   kind: NotificationKind;
  580:   subjectId?: SubjectId;
  581:   proposalId?: ProposalId;
  582:   agentFindings?: string;
  583:   briefId?: string;
  584: }) {
  585:   const n: Notification = {
  586:     id: nextId("N"),
  587:     toPersonId: args.toPersonId,
  588:     kind: args.kind,
  589:     subjectId: args.subjectId,
  590:     proposalId: args.proposalId,
  591:     agentFindings: args.agentFindings,
  592:     briefId: args.briefId,
  593:     read: false,
  594:     createdAt: nowIso(),
  595:   };
  596:   set((s) => ({ notifications: [...s.notifications, n] }));
  597: }
  598: 
  599: export function openNotification(id: string) {
  600:   const n = state.notifications.find((x) => x.id === id);
  601:   if (!n) return;
  602:   if (n.kind === "evidence-brief") {
  603:     // A brief is read where it arrived; management and department staff have no studio to land in.
  604:     set((s) => ({ notifications: s.notifications.map((x) => (x.id === id ? { ...x, read: true } : x)), selectedBriefId: n.briefId ?? null, screen: "inbox" }));
  605:     return;
  606:   }
  607:   set((s) => ({
  608:     notifications: s.notifications.map((x) => (x.id === id ? { ...x, read: true } : x)),
  609:   }));
  610:   if (n.proposalId) selectProposal(n.proposalId);
  611:   if (n.subjectId) selectSubject(n.subjectId);
  612:   selectStudioTab("content");
  613:   // Land the reader in context.
  614:   const person = currentPerson();
  615:   if (!person) return;
  616:   if (n.kind === "review-request") navigate("studio");
  617:   else if (n.kind === "ping-update") navigate("studio");
  618:   else if (n.kind === "ping-new-subject") navigate("new-subject");
  619:   else if (n.kind === "test-done" || n.kind === "approved" || n.kind === "rejected") {
  620:     navigate(person.orgRole === "management" ? "approval" : "studio");
  621:   }
  622: }
