  980: /** Edit a single CLO-change line. */
  981: export function editCloChangeText(proposalId: ProposalId, index: number, text: string) {
  982:   patchProposal(proposalId, (p) => {
  983:     const cloChanges = [...(p.draft.cloChanges ?? [])];
  984:     if (cloChanges[index]) cloChanges[index] = { ...cloChanges[index], text };
  985:     return { ...p, draft: { ...p.draft, cloChanges } };
  986:   });
