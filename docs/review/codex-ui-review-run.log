 1216: /** A lecturer submits their test for coordinator review; a coordinator's own
 1217:  *  draft can be approved directly. Same authority chain as proposals. */
 1218: export function submitTestDraft(testDraftId: string) {
 1219:   const t = state.testDrafts.find((x) => x.id === testDraftId);
 1220:   const person = currentPerson();
 1221:   if (!t || !person || t.authorId !== person.id || !mayEditAssessment(t) || t.status !== "drafting") return;
 1222:   if (t.needsReview || assessmentLinkError(t)) { set({ toast: "Review the course change and repair outcome links before submitting this assessment." }); return; }
 1223:   const isCoord = hatsOn(t.authorId, t.subjectId, state.assignments).includes("coordinator");
 1224:   if (isCoord) {
 1225:     set((s) => ({
 1226:       testDrafts: s.testDrafts.map((x) => (x.id === testDraftId ? { ...x, status: "approved" } : x)),
 1227:       toast: "Test approved (coordinator's own draft).",
 1228:     }));
 1229:     return;
 1230:   }
 1231:   set((s) => ({
 1232:     testDrafts: s.testDrafts.map((x) =>
 1233:       x.id === testDraftId ? { ...x, status: "coordinator-review" } : x,
 1234:     ),
 1235:   }));
 1236:   const coord = personWithHat(t.subjectId, "coordinator");
 1237:   if (coord) {
 1238:     notify({
 1239:       toPersonId: coord.id,
 1240:       kind: "review-request",
 1241:       subjectId: t.subjectId,
 1242:       proposalId: t.proposalId,
 1243:       agentFindings: "A lecturer has drafted a test and is asking for your review.",
 1244:     });
 1245:   }
 1246:   set({ toast: "Test sent to the coordinator for review." });
 1247: }
 1248: 
 1249: export function approveTestDraft(testDraftId: string) {
 1250:   const t = state.testDrafts.find((x) => x.id === testDraftId);
 1251:   const person = currentPerson();
 1252:   if (!t || !person || t.status !== "coordinator-review") return;
 1253:   if (t.needsReview || assessmentLinkError(t)) { set({ toast: "Review the course change and repair outcome links before approving this assessment." }); return; }
 1254:   if (!can(person, "review-draft", { subjectId: t.subjectId, assignments: state.assignments })) {
 1255:     set({ toast: "Only the subject coordinator can approve a test." });
 1256:     return;
 1257:   }
 1258:   set((s) => ({
 1259:     testDrafts: s.testDrafts.map((x) => (x.id === testDraftId ? { ...x, status: "approved" } : x)),
 1260:     toast: "Test approved.",
 1261:   }));
 1262: }
