src/ui/screens/Office.tsx
   1: // How Lyceum works: the seven roles as a pipeline, then the real step-by-step
   2: // record for the course you are working on. Every event on the timeline is
   3: // derived from something the workspace holds; nothing here is a fixture.
   4: 
   5: import { useState } from "react";
   6: import { BarChart3, BookOpen, ChevronDown, ChevronRight, Map as MapIcon, PenLine, Presentation, Search, ShieldCheck, type LucideIcon } from "lucide-react";
   7: import { ROLES, runTimeline, type RoleId } from "../../app/runs.ts";
   8: import { subjectsForPerson } from "../../app/roles.ts";
   9: import { currentPerson, navigate, selectStudioTab, selectSubject, useStore } from "../../app/store.ts";
  10: import { Button, Page, PageHead, Select, Tag } from "../primitives/index.tsx";
  11: 
  12: const ICONS: Record<RoleId, LucideIcon> = { folio: BookOpen, scout: Search, atlas: MapIcon, quill: PenLine, prism: Presentation, lens: BarChart3, steward: ShieldCheck };
  13: 
  14: export function OfficeScreen() {
  15:   const state = useStore();
  16:   const person = currentPerson();
  17:   const [open, setOpen] = useState<RoleId | null>(null);
  18:   if (!person) return null;
  19:   const mine = person.orgRole === "academic" ? subjectsForPerson(person.id, state.assignments) : state.subjects.map((s) => s.id);
  20:   const subjectId = state.selectedSubjectId && mine.includes(state.selectedSubjectId) ? state.selectedSubjectId : mine[0] ?? null;
  21:   const events = runTimeline(state, subjectId);
  22:   const roleName = (id: RoleId) => ROLES.find((r) => r.id === id)!;
  23:   return <Page wide>
  24:     <PageHead title="How Lyceum works" context="Seven roles, one afternoon, nothing automatic. Each role reads what you confirmed and hands the next one a record you can open." />
  25:     <ol className="pipeline" aria-label="The seven roles in order">
  26:       {ROLES.map((role) => { const Icon = ICONS[role.id]; const expanded = open === role.id; return <li key={role.id} className={expanded ? "is-open" : ""}>
  27:         <button type="button" className="pipeline-card" aria-expanded={expanded} onClick={() => setOpen(expanded ? null : role.id)} data-demo-id={"role-" + role.id}>
  28:           <span className="pipeline-icon" aria-hidden><Icon size={22} /></span>
  29:           <span className="pipeline-name">{role.name}</span>
  30:           <span className="pipeline-job">{role.job}</span>
  31:           <span className="pipeline-more" aria-hidden>{expanded ? <ChevronDown size={14} /> : <ChevronRight size={14} />}</span>
  32:         </button>
  33:         {expanded ? <dl className="pipeline-detail"><div><dt>Reads</dt><dd>{role.reads}</dd></div><div><dt>Produces</dt><dd>{role.produces}</dd></div><div><dt>Cannot</dt><dd>{role.cannot}</dd></div></dl> : null}
  34:       </li>; })}
  35:     </ol>
  36:     <div className="principle-strip" aria-label="Principles">
  37:       <div><strong>Only on request</strong><span>Nothing fetches or drafts until you ask.</span></div>
  38:       <div><strong>Exact quotations</strong><span>A requirement is a sentence from its source, or it is rejected.</span></div>
  39:       <div><strong>Denominator in view</strong><span>Counts over postings you reviewed, with an interval. No score.</span></div>
  40:       <div><strong>People decide</strong><span>Briefs go to colleagues; the university's process stays in charge.</span></div>
  41:     </div>
  42: 
  43:     <section className="workspace-panel" aria-labelledby="run-record">
  44:       <div className="section-heading"><div><h2 id="run-record">What actually happened{subjectId ? " on " + subjectId : ""}</h2><p className="muted">Every line below is derived from a record in this workspace, in the order it was created.</p></div>
  45:         {mine.length > 1 ? <label className="course-switcher">Course<Select aria-label="Choose course" value={subjectId ?? ""} onChange={(e) => selectSubject(e.target.value)}>{mine.map((id) => <option key={id} value={id}>{id}</option>)}</Select></label> : null}</div>
  46:       {events.length ? <ol className="timeline" data-demo-id="run-timeline">{events.map((e, i) => <li key={i}>
  47:         <span className="timeline-time num">{e.at.slice(0, 16).replace("T", " ")}</span>
  48:         <span className="timeline-role"><Tag tone="accent">{roleName(e.role).name}</Tag><span className="muted">{roleName(e.role).job}</span></span>
  49:         <div className="timeline-body"><strong>{e.title}</strong><p className="muted">{e.detail}</p></div>
  50:         {e.tab && subjectId ? <Button variant="quiet" aria-label={"Open " + e.title} onClick={() => { selectSubject(subjectId); selectStudioTab(e.tab!); navigate("studio"); }}>Open</Button> : null}
  51:       </li>)}</ol>
  52:         : <div className="empty-run"><p>No step has run on this course yet. Open the course and follow the journey bar, or press Play demo on the sign-in screen to watch one afternoon end to end.</p>
  53:           <Button variant="primary" onClick={() => navigate("courses")}>Open a course</Button></div>}
  54:     </section>
  55:     <p className="muted">Want to see how this is tested? <Button variant="quiet" onClick={() => navigate("evaluation")}>Open Evaluation</Button></p>
  56:   </Page>;
  57: }
