  377: // ---------- selectors ----------
  378: export function currentPerson(): Person | null {
  379:   return state.people.find((p) => p.id === state.currentPersonId) ?? null;
  380: }
  381: export function personById(id: PersonId): Person | undefined {
  382:   return state.people.find((p) => p.id === id);
