 1264: // ---------- proposal state machine ----------
 1265: /** Lecturer-only author submits to the coordinator for review. */
 1266: export function submitForReview(proposalId: ProposalId) {
 1267:   const p = proposalById(proposalId);
 1268:   if (!p) return;
