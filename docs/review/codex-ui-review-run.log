   2: // renders inside the Shell. Navigation syncs to the URL hash (#/screen) so
   3: // refresh, back, and deep links work like a real app.
   4: 
   5: import { useEffect } from "react";
   6: import type { Screen } from "./app/roles.ts";
   7: import { navAllows } from "./app/roles.ts";
   8: import { currentPerson, getState, navigate, useStore } from "./app/store.ts";
   9: import { Shell } from "./ui/shell/Shell.tsx";
  10: import { SCREENS } from "./ui/screens/index.ts";
  11: import { DemoOverlay } from "./demo/DemoOverlay.tsx";
  12: import { LandingScreen } from "./ui/screens/Landing.tsx";
  13: 
  14: const HASH_SCREENS: Screen[] = [
  15:   "login",
  16:   "index",
  17:   "inbox",
  18:   "trends",
  19:   "approval",
  20:   "programme",
  21:   "new-subject",
  22:   "assignments",
  23:   "courses",
  24:   "studio",
  25:   "acceptance",
  26:   "upload",
  27:   "backtest",
  28:   "dataroom",
  29:   "office",
  30:   "evaluation",
  31:   "guide",
  32: ];
  33: 
  34: function parseHash(): Screen | null {
  35:   const h = window.location.hash.replace(/^#\/?/, "");
  36:   return (HASH_SCREENS as string[]).includes(h) ? (h as Screen) : null;
  37: }
  38: 
  39: export default function App() {
  40:   const state = useStore();
  41: 
  42:   // Keep the hash in step with the screen (deep links, refresh, back button).
  43:   useEffect(() => {
  44:     const want = `#/${state.screen}`;
  45:     if (window.location.hash !== want) {
  46:       // replaceState for programmatic moves keeps back-button history sane for
  47:       // the common case; the browser still records user-initiated hash changes.
  48:       window.history.pushState(null, "", want);
  49:     }
  50:   }, [state.screen]);
  51: 
  52:   useEffect(() => {
  53:     function onHashChange() {
  54:       const target = parseHash();
  55:       if (!target) return;
  56:       const s = getState();
  57:       const person = currentPerson();
  58:       if (!person) {
  59:         if (target === "index" || target === "login") navigate(target);
  60:         return;
  61:       }
  62:       if (navAllows(person, s.assignments, target) && target !== s.screen) navigate(target);
  63:     }
  64:     // On first load, honour a deep link.
  65:     onHashChange();
  66:     window.addEventListener("hashchange", onHashChange);
  67:     window.addEventListener("popstate", onHashChange);
  68:     return () => {
  69:       window.removeEventListener("hashchange", onHashChange);
  70:       window.removeEventListener("popstate", onHashChange);
  71:     };
  72:   }, []);
  73: 
  74:   const ScreenComponent = SCREENS[state.screen];
  75: 
  76:   // Signed out, only the two public surfaces render (bare, no shell). Signed
  77:   // in, everything (the index included) renders inside the shell. The demo
  78:   // overlay is a stable last sibling in every branch, so a login/shell swap
  79:   // never unmounts a running demo.
  80:   let content;
  81:   if (!state.currentPersonId) {
  82:     // Signed out, the index route is the public landing page. The Relevance
  83:     // Index sandbox itself stays behind sign-in, labelled as illustrative.
  84:     const Public = state.screen === "index" ? LandingScreen : SCREENS.login;
  85:     content = <Public />;
  86:   } else if (state.screen === "login") {
  87:     const Login = SCREENS.login;
  88:     content = <Login />;
  89:   } else {
  90:     content = (
  91:       <Shell>
  92:         <ScreenComponent />
  93:       </Shell>
  94:     );
  95:   }
  96: 
  97:   return (
  98:     <div style={{ height: "100%" }}>
  99:       {content}
 100:       <DemoOverlay />
 101:     </div>
 102:   );
 103: }

