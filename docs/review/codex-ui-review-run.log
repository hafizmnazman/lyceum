  423: export function saveTeachingPlanDetails(subjectId: SubjectId, details: { term: string; notes: string }): SaveResult {
  424:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can edit this teaching plan." };
  425:   updateTeachingPlan(subjectId, (plan) => ({ ...plan, term: details.term.trim(), notes: details.notes.trim() }));
  426:   return { ok: true };
  427: }
  428: 
  429: export function saveTeachingSession(subjectId: SubjectId, input: SessionInput): SaveResult {
  430:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can edit this teaching plan." };
  431:   const previous = state.teachingPlans.find((p) => p.subjectId === subjectId);
  432:   if (input.id && !previous?.sessions.some((s) => s.id === input.id))
  433:     return { ok: false, error: "This session no longer exists. Add a new session instead." };
  434:   const issues = sessionIssues(input, state.clos.filter((c) => c.subjectId === subjectId));
  435:   if (issues.length) return { ok: false, error: issues.join(" ") };
  436:   const session = {
  437:     ...input, id: input.id ?? nextId("TS"), topic: input.topic.trim(),
  438:     cloIds: [...new Set(input.cloIds)], activity: input.activity.trim(),
  439:     learningCheck: input.learningCheck.trim(), resources: input.resources.trim(),
  440:     updatedAt: nowIso(), updatedBy: state.currentPersonId!,
  441:     courseVersionId: subjectById(subjectId)?.currentVersionId, needsReview: false,
  442:   };
  443:   updateTeachingPlan(subjectId, (plan) => ({ ...plan, sessions: [...plan.sessions.filter((s) => s.id !== session.id), session] }));
  444:   return { ok: true };
  445: }
  446: 
  447: export function deleteTeachingSession(subjectId: SubjectId, sessionId: string): SaveResult {
  448:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can edit this teaching plan." };
  449:   const plan = state.teachingPlans.find((p) => p.subjectId === subjectId);
  450:   if (!plan?.sessions.some((s) => s.id === sessionId)) return { ok: false, error: "This session no longer exists." };
  451:   updateTeachingPlan(subjectId, (p) => ({ ...p, sessions: p.sessions.filter((s) => s.id !== sessionId) }));
  452:   return { ok: true };
  453: }
