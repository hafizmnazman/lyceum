  48: 
  49:   // Cmd+K / Ctrl+K opens the palette from anywhere.
  50:   useEffect(() => {
  51:     function onKey(e: KeyboardEvent) {
  52:       if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
  53:         e.preventDefault();
  54:         setPaletteOpen((v) => !v);
  55:       }
  56:       if (e.key === "Escape") { setMenuOpen(false); setNavOpen(false); }
  57:     }
  58:     window.addEventListener("keydown", onKey);
  59:     return () => window.removeEventListener("keydown", onKey);
  60:   }, []);
  61: 
  62:   // Click-away for the account menu.
  63:   useEffect(() => {
  64:     if (!menuOpen) return;
  65:     function onClick(e: MouseEvent) {
  66:       if (menuRef.current && !menuRef.current.contains(e.target as Node)) setMenuOpen(false);
  67:     }
  68:     window.addEventListener("mousedown", onClick);
  69:     return () => window.removeEventListener("mousedown", onClick);
  70:   }, [menuOpen]);
