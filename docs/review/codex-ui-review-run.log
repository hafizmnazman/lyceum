 1004: /** Start a fresh draft on a subject that has no open proposal. Authored by the
 1005:  *  current person, so a lecturer's draft is correctly lecturer-authored (and so
 1006:  *  must pass coordinator review before testing). Selects it. */
 1007: export function startDraft(subjectId: SubjectId): ProposalId | null {
 1008:   const person = currentPerson();
 1009:   if (!person || !subjectById(subjectId) || !can(person, "draft-change", { subjectId, assignments: state.assignments })) return null;
 1010:   const existing = state.proposals.find(
 1011:     (p) => p.subjectId === subjectId && p.status !== "approved" && p.status !== "rejected",
 1012:   );
 1013:   if (existing) {
 1014:     selectSubject(subjectId);
 1015:     selectProposal(existing.id);
 1016:     selectStudioTab("content");
 1017:     return existing.id;
 1018:   }
 1019:   const clo = state.clos.find((c) => c.subjectId === subjectId);
 1020:   const id = `CP-${subjectId}-${state.idSeq}`;
 1021:   const proposal: ChangeProposal = {
 1022:     id,
 1023:     subjectId,
 1024:     kind: "update",
 1025:     authorId: person.id,
 1026:     draft: {
 1027:       topics: [],
 1028:       cloChanges: clo
 1029:         ? [{ cloId: clo.id, op: "edit", text: clo.text, bloomLevel: clo.bloomLevel }]
 1030:         : [],
 1031:     },
 1032:     status: "drafting",
 1033:     history: [{ at: nowIso(), byPersonId: person.id, action: "drafted", note: "Draft started." }],
 1034:   };
 1035:   set((s) => ({
 1036:     proposals: [...s.proposals, proposal],
 1037:     idSeq: s.idSeq + 1,
 1038:     selectedSubjectId: subjectId,
 1039:     selectedProposalId: id,
 1040:     studioTab: "content",
 1041:   }));
 1042:   return id;
 1043: }
