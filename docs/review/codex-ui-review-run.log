  387: export function proposalById(id: ProposalId | null): ChangeProposal | undefined {
  388:   return id ? state.proposals.find((p) => p.id === id) : undefined;
  389: }
  390: export function unreadFor(personId: PersonId): Notification[] {
  391:   return state.notifications.filter((n) => n.toPersonId === personId && !n.read);
  392: }
  393: export function inboxFor(personId: PersonId): Notification[] {
  394:   return [...state.notifications]
  395:     .filter((n) => n.toPersonId === personId)
  396:     .sort((a, b) => (a.createdAt === b.createdAt ? 0 : a.createdAt < b.createdAt ? 1 : -1));
  397: }
  398: /** First person who holds the given hat on a subject. */
  399: export function personWithHat(subjectId: SubjectId, hat: Hat): Person | undefined {
  400:   const a = state.assignments.find((x) => x.subjectId === subjectId && x.hat === hat);
  401:   return a ? personById(a.personId) : undefined;
  402: }
  403: export function ratingFor(subjectId: SubjectId): RelevanceRating | undefined {
  404:   return state.relevanceRatings.find((r) => r.subjectId === subjectId);
