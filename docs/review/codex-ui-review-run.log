 1873: // ---------- lecturer-supplied evidence receipts (plan Sections 7 and 8, manual path) ----------
 1874: // Nothing here fetches. A source is the text the lecturer pasted; a mention is an
 1875: // exact quotation from it; a mapping is the lecturer's reviewed coverage judgement.
 1876: export function addEvidenceSource(subjectId: SubjectId, input: EvidenceSourceInput): SaveResult & { sourceId?: string } {
 1877:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can record evidence for this course." };
 1878:   const error = evidenceSourceError(input);
 1879:   if (error) return { ok: false, error };
 1880:   const text = input.text.trim(), textHash = textFingerprint(text), normalised = normaliseWhitespace(text).toLowerCase();
 1881:   const original = state.evidenceSources.find((s) => s.subjectId === subjectId && s.kind === input.kind && s.duplicateOf === null &&
 1882:     s.textHash === textHash && normaliseWhitespace(s.text).toLowerCase() === normalised);
 1883:   const source: EvidenceSource = { id: nextId("EV-" + subjectId), subjectId, kind: input.kind, title: normaliseWhitespace(input.title),
 1884:     organisation: normaliseWhitespace(input.organisation), url: input.url.trim(), sourceDate: input.sourceDate.trim(), text, textHash,
 1885:     duplicateOf: original?.id ?? null, provenance: "lecturer-supplied", reviewed: false, addedBy: currentPerson()!.id, addedAt: nowIso() };
 1886:   set((s) => ({ evidenceSources: [...s.evidenceSources, source],
 1887:     toast: original ? "Recorded as a duplicate copy of " + original.title + ". It counts once." : "Source recorded. Quote its requirements, then mark the extraction reviewed." }));
 1888:   return { ok: true, sourceId: source.id };
 1889: }
 1890: export function setEvidenceSourceReviewed(sourceId: string, reviewed: boolean): SaveResult {
 1891:   const source = state.evidenceSources.find((s) => s.id === sourceId);
 1892:   if (!source || !mayPlan(source.subjectId)) return { ok: false, error: "You cannot change this evidence source." };
 1893:   if (source.duplicateOf) return { ok: false, error: "Review the original copy; duplicates follow it." };
 1894:   if (source.kind !== "job-posting") return { ok: false, error: "Only job postings enter the denominator. Contextual documents are listed, not counted." };
 1895:   set((s) => ({ evidenceSources: s.evidenceSources.map((x) => (x.id === sourceId ? { ...x, reviewed } : x)),
 1896:     toast: reviewed ? "Extraction marked reviewed. This posting now counts in the denominator." : "Extraction marked unreviewed. This posting is excluded until reviewed." }));
 1897:   return { ok: true };
 1898: }
 1899: export function removeEvidenceSource(sourceId: string): SaveResult {
 1900:   const source = state.evidenceSources.find((s) => s.id === sourceId);
 1901:   if (!source || !mayPlan(source.subjectId)) return { ok: false, error: "You cannot remove this evidence source." };
 1902:   const promoted = state.evidenceSources.find((s) => s.duplicateOf === sourceId);
 1903:   set((s) => ({
 1904:     evidenceSources: s.evidenceSources.filter((x) => x.id !== sourceId).map((x) => x.duplicateOf !== sourceId ? x
 1905:       : x.id === promoted?.id ? { ...x, duplicateOf: null, reviewed: source.reviewed } : { ...x, duplicateOf: promoted!.id }),
 1906:     skillMentions: s.skillMentions.filter((m) => m.sourceId !== sourceId),
 1907:     toast: "Source and its quotations removed." + (promoted ? " " + promoted.title + " is now the original copy." : ""),
 1908:   }));
 1909:   return { ok: true };
 1910: }
 1911: export function addSkillMention(sourceId: string, input: MentionInput): SaveResult & { mentionId?: string } {
 1912:   const source = state.evidenceSources.find((s) => s.id === sourceId);
 1913:   if (!source || !mayPlan(source.subjectId)) return { ok: false, error: "You cannot quote from this evidence source." };
 1914:   const error = mentionError(input, source.text);
 1915:   if (error) return { ok: false, error };
 1916:   const skill = normaliseWhitespace(input.skill), excerpt = input.excerpt.trim(), key = skillKey(skill);
 1917:   if (state.skillMentions.some((m) => m.sourceId === sourceId && skillKey(m.skill) === key && normaliseWhitespace(m.excerpt).toLowerCase() === normaliseWhitespace(excerpt).toLowerCase()))
 1918:     return { ok: false, error: "That excerpt is already recorded for this skill." };
 1919:   const mention: SkillMention = { id: nextId("SM-" + source.subjectId), sourceId, subjectId: source.subjectId, skill, excerpt,
 1920:     requirement: input.requirement, addedBy: currentPerson()!.id, addedAt: nowIso() };
 1921:   set((s) => ({ skillMentions: [...s.skillMentions, mention], toast: "Requirement quoted from " + source.title + "." }));
 1922:   return { ok: true, mentionId: mention.id };
 1923: }
 1924: export function removeSkillMention(mentionId: string): SaveResult {
 1925:   const mention = state.skillMentions.find((m) => m.id === mentionId);
 1926:   if (!mention || !mayPlan(mention.subjectId)) return { ok: false, error: "You cannot remove this quotation." };
 1927:   set((s) => ({ skillMentions: s.skillMentions.filter((m) => m.id !== mentionId), toast: "Quotation removed." }));
 1928:   return { ok: true };
 1929: }
 1930: export function setSkillMapping(subjectId: SubjectId, input: MappingInput): SaveResult {
 1931:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can map evidence to this course." };
 1932:   const outcomes = state.clos.filter((c) => c.subjectId === subjectId);
 1933:   const error = mappingError(input, outcomes.map((c) => c.id));
 1934:   if (error) return { ok: false, error };
 1935:   const key = skillKey(input.skill);
 1936:   const display = state.skillMentions.find((m) => m.subjectId === subjectId && skillKey(m.skill) === key)?.skill ?? normaliseWhitespace(input.skill);
 1937:   const mapping: SkillMapping = { subjectId, skill: display, cloIds: [...input.cloIds], stage: input.stage, target: input.target,
 1938:     evidence: input.evidence.trim(), updatedBy: currentPerson()!.id, updatedAt: nowIso() };
 1939:   set((s) => ({ skillMappings: [...s.skillMappings.filter((m) => !(m.subjectId === subjectId && skillKey(m.skill) === key)), mapping],
 1940:     toast: "Coverage mapping saved. It records your reviewed judgement, not a measured outcome." }));
 1941:   return { ok: true };
 1942: }
 1943: export function evidenceReportForCourse(subjectId: SubjectId) {
 1944:   return evidenceReport(subjectId, state.evidenceSources, state.skillMentions, state.skillMappings, state.clos.filter((c) => c.subjectId === subjectId));
 1945: }
