 450: function NavItem(props: { screen: Screen; active: boolean; badge: number }) {
 451:   if (props.screen === "login") return null;
 452:   const meta = NAV_META[props.screen];
 453:   const Icon = meta.icon;
 454:   return (
 455:     <button
 456:       data-demo-id={`nav-${props.screen}`}
 457:       onClick={() => navigate(props.screen)}
 458:       aria-current={props.active ? "page" : undefined}
 459:       style={{
 460:         display: "flex",
 461:         alignItems: "center",
 462:         gap: 10,
 463:         width: "100%",
 464:         padding: "7px 10px",
 465:         marginBottom: 1,
 466:         borderRadius: "var(--radius-s)",
 467:         border: "none",
 468:         cursor: "pointer",
 469:         fontSize: 13.5,
 470:         fontWeight: props.active ? 600 : 400,
 471:         color: props.active ? "var(--accent)" : "var(--ink-2)",
 472:         background: props.active ? "var(--accent-soft)" : "transparent",
 473:         transition: "background 150ms ease-out",
 474:       }}
 475:     >
 476:       <Icon size={16} strokeWidth={1.75} />
 477:       <span style={{ flex: 1, textAlign: "left" }}>{meta.label}</span>
 478:       {props.badge > 0 ? (
 479:         <span
 480:           className="num"
 481:           style={{
 482:             minWidth: 18,
 483:             height: 18,
 484:             padding: "0 5px",
 485:             borderRadius: 999,
 486:             background: "var(--accent)",
 487:             color: "var(--accent-ink)",
 488:             fontSize: 11,
 489:             fontWeight: 600,
 490:             display: "flex",
 491:             alignItems: "center",
 492:             justifyContent: "center",
 493:           }}
 494:         >
 495:           {props.badge}
 496:         </span>
 497:       ) : null}
 498:     </button>
 499:   );
 500: }
 501: 
 502: function HatBadge(props: { label: string; title: string }) {
 503:   return (
 504:     <span
 505:       title={props.title}
