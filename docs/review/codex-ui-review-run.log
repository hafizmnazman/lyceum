  120: // ---------- time ----------
  121: // The seed clock: every seeded timestamp, and every timestamp in demo/proof
  122: // mode, so those paths are identical every run. In the browser (outside the
  123: // demo) actions stamp real time, which is what makes the app feel live.
  124: const SEED_NOW = "2026-07-01T10:00:00Z";
