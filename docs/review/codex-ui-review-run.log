 1947: // ---------- the lecturer's research run (plan Section 7, manual and permitted-board paths) ----------
 1948: export interface CollectRun {
 1949:   subjectId: SubjectId; provider: CollectionProvider; board: string; query: string; inText: boolean;
 1950:   status: "running" | "done" | "failed"; postings: CollectedPosting[]; retrievedAt: string | null; cached: boolean; total: number; error: string | null; label: string;
 1951:   log: string[]; // what actually happened, with clock times: the request, the bytes received, the match
 1952:   endpoint: string | null; bytes: number | null; durationMs: number | null;
 1953: }
 1954: const clock = () => new Date().toTimeString().slice(0, 8);
 1955: type CollectionLoader = (request: CollectionRequest) => Promise<CollectionOutcome>;
 1956: /** Fetch postings from a permitted board or the saved sample. Only on request; nothing is imported until the lecturer chooses. */
 1957: export async function runCollection(subjectId: SubjectId, input: { provider: CollectionProvider; board: string; query: string; inText: boolean }, loader: CollectionLoader = fetchCollection): Promise<SaveResult> {
 1958:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can collect evidence for this course." };
 1959:   if (!SOURCE_POLICIES[input.provider]?.enabled) return { ok: false, error: "Choose a supported source." };
 1960:   const board = input.provider === "sample" ? "sample" : input.board.trim().toLowerCase();
 1961:   if (input.provider !== "sample" && !BOARD_TOKEN.test(board)) return { ok: false, error: "Enter the employer's board token: letters, digits, hyphens or underscores, for example the NAME in jobs.lever.co/NAME or boards.greenhouse.io/NAME." };
 1962:   const run = { subjectId, provider: input.provider, board, query: input.query.trim(), inText: Boolean(input.inText) };
 1963:   const opening = clock() + (input.provider === "sample"
 1964:     ? " Loading the saved sample shipped with the app. No network request."
 1965:     : " Requesting " + SOURCE_POLICIES[input.provider].name + " \"" + board + "\" through the local API (/api/collect/" + input.provider + "/" + board + "). Only this host is permitted.");
 1966:   set({ collectRun: { ...run, status: "running", postings: [], retrievedAt: null, cached: false, total: 0, error: null, label: "", log: [opening], endpoint: null, bytes: null, durationMs: null } });
 1967:   const result = await loader(run);
 1968:   const current = state.collectRun;
 1969:   if (!current || current.status !== "running" || current.subjectId !== subjectId || current.board !== board || current.provider !== input.provider) return { ok: true };
 1970:   if (result.ok) {
 1971:     const size = typeof result.bytes === "number" ? " (" + (result.bytes >= 1048576 ? (result.bytes / 1048576).toFixed(1) + " MB" : Math.round(result.bytes / 1024) + " kB") + ")" : "";
 1972:     const took = typeof result.durationMs === "number" ? " in " + (result.durationMs / 1000).toFixed(1) + " s" : "";
 1973:     const received = clock() + " Received " + result.total + " postings" + size + " from " + (result.endpoint ?? "the source") + took + (input.provider === "sample" ? ". Sample retrieved " + result.retrievedAt + "." : result.cached ? ". Served from the local cache; fetched live at " + result.retrievedAt + "." : ". Fetched live at " + result.retrievedAt + ".");
 1974:     const matched = clock() + " Kept " + result.postings.length + " of " + result.total + (run.query ? " whose " + (run.inText ? "title or text" : "title") + " matches \"" + run.query + "\"." : " (no keywords).") + " Nothing is imported until you choose.";
 1975:     set({ collectRun: { ...run, status: "done", postings: result.postings, retrievedAt: result.retrievedAt, cached: result.cached, total: result.total, error: null, label: result.label,
 1976:       log: [opening, received, matched], endpoint: result.endpoint ?? null, bytes: result.bytes ?? null, durationMs: result.durationMs ?? null } });
 1977:     return { ok: true };
 1978:   }
 1979:   set({ collectRun: { ...run, status: "failed", postings: [], retrievedAt: null, cached: false, total: 0, error: result.error, label: "", log: [opening, clock() + " Failed: " + result.error], endpoint: null, bytes: null, durationMs: null } });
 1980:   return { ok: false, error: result.error };
 1981: }
 1982: export function clearCollection() { set({ collectRun: null }); }
 1983: /** Keep chosen postings as sources. Each is a receipt with its link, publication date and retrieval time; it counts only after review. */
 1984: export function importCollectedPostings(subjectId: SubjectId, postingIds: string[]): SaveResult & { imported?: number; skipped?: number } {
 1985:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can import evidence for this course." };
 1986:   const run = state.collectRun;
 1987:   if (!run || run.subjectId !== subjectId || run.status !== "done") return { ok: false, error: "Fetch postings first." };
 1988:   const chosen = run.postings.filter((p) => postingIds.includes(p.id));
 1989:   if (!chosen.length) return { ok: false, error: "Select at least one posting to import." };
 1990:   const person = currentPerson()!;
 1991:   const already = new Set(state.evidenceSources.filter((s) => s.subjectId === subjectId).map((s) => s.collection?.postingId ?? ""));
 1992:   const added: EvidenceSource[] = [];
 1993:   let imported = 0, skipped = 0;
 1994:   for (const posting of chosen) {
 1995:     const text = posting.text.trim();
 1996:     if (already.has(posting.id) || text.length < 20) { skipped += 1; continue; }
 1997:     const textHash = textFingerprint(text), normalised = normaliseWhitespace(text).toLowerCase();
 1998:     const original = [...state.evidenceSources, ...added].find((s) => s.subjectId === subjectId && s.kind === "job-posting" && s.duplicateOf === null &&
 1999:       s.textHash === textHash && normaliseWhitespace(s.text).toLowerCase() === normalised);
 2000:     added.push({ id: nextId("EV-" + subjectId), subjectId, kind: "job-posting", title: normaliseWhitespace(posting.title), organisation: normaliseWhitespace(posting.organisation),
 2001:       url: posting.url, sourceDate: posting.publishedAt ? posting.publishedAt.slice(0, 10) : "", text, textHash, duplicateOf: original?.id ?? null, provenance: "collected",
 2002:       collection: { provider: posting.provider, board: posting.board, postingId: posting.id, retrievedAt: posting.retrievedAt, label: run.label || SOURCE_POLICIES[posting.provider].name },
 2003:       reviewed: false, addedBy: person.id, addedAt: nowIso() });
 2004:     already.add(posting.id); imported += 1;
 2005:   }
 2006:   set((s) => ({ evidenceSources: [...s.evidenceSources, ...added],
 2007:     toast: imported + " postings imported as sources, " + skipped + " skipped. Quote their requirements, then mark the extraction reviewed." }));
 2008:   return { ok: true, imported, skipped };
 2009: }
 2010: export function setSkillLexicon(subjectId: SubjectId, terms: string[]): SaveResult {
 2011:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can set the terms for this course." };
 2012:   if (!Array.isArray(terms) || terms.length > 100 || terms.some((t) => typeof t !== "string" || !t.trim() || t.length > 60)) return { ok: false, error: "Use up to 100 terms of at most 60 characters each." };
 2013:   set((s) => ({ skillLexicon: { ...s.skillLexicon, [subjectId]: terms.map((t) => normaliseWhitespace(t)) }, toast: "Terms saved with the course." }));
 2014:   return { ok: true };
 2015: }
 2016: /** Propose one exact sentence per posting and term. The lecturer confirms; nothing is recorded by the scan itself. */
 2017: export function scanForRequirements(subjectId: SubjectId): SaveResult & { count?: number } {
 2018:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can scan evidence for this course." };
 2019:   const terms = state.skillLexicon[subjectId] ?? [];
 2020:   if (!terms.length) return { ok: false, error: "Save the skills to look for first." };
 2021:   const proposals = proposeMentions(state.evidenceSources.filter((s) => s.subjectId === subjectId), terms, state.skillMentions.filter((m) => m.subjectId === subjectId));
 2022:   set({ scanProposals: proposals, toast: proposals.length ? proposals.length + " quotations proposed. Confirm the ones you accept." : "No new sentence names those terms." });
 2023:   return { ok: true, count: proposals.length };
 2024: }
 2025: export function confirmProposals(subjectId: SubjectId, proposals: MentionProposal[]): { added: number; skipped: number } {
 2026:   let added = 0, skipped = 0;
 2027:   const handled = new Set<string>();
 2028:   for (const proposal of proposals) {
 2029:     const source = state.evidenceSources.find((s) => s.id === proposal.sourceId);
 2030:     if (!source || source.subjectId !== subjectId) { skipped += 1; continue; }
 2031:     const result = addSkillMention(proposal.sourceId, { skill: proposal.skill, excerpt: proposal.excerpt, requirement: proposal.requirement });
 2032:     if (result.ok) added += 1; else skipped += 1;
 2033:     handled.add(proposal.sourceId + "\n" + proposal.term);
 2034:   }
 2035:   set((s) => ({ scanProposals: s.scanProposals.filter((p) => !handled.has(p.sourceId + "\n" + p.term)), toast: added + " quotations recorded, " + skipped + " skipped." }));
 2036:   return { added, skipped };
 2037: }
 2038: export function dismissProposal(sourceId: string, term: string) {
 2039:   set((s) => ({ scanProposals: s.scanProposals.filter((p) => !(p.sourceId === sourceId && p.term === term)) }));
 2040: }
 2041: export function clearProposals() { set({ scanProposals: [] }); }
 2042: /** Bulk review: the lecturer vouches that every listed posting's extraction is complete. Duplicates follow their original. */
 2043: export function setSourcesReviewed(subjectId: SubjectId, sourceIds: string[], reviewed: boolean): SaveResult {
 2044:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can review evidence for this course." };
 2045:   const ids = new Set(sourceIds);
 2046:   set((s) => ({ evidenceSources: s.evidenceSources.map((x) => ids.has(x.id) && x.subjectId === subjectId && x.kind === "job-posting" && !x.duplicateOf ? { ...x, reviewed } : x),
 2047:     toast: reviewed ? "Extraction marked reviewed. These postings now count in the denominator." : "Postings marked unreviewed and excluded until reviewed." }));
 2048:   return { ok: true };
 2049: }
 2050: export function selectBrief(briefId: string | null) { set({ selectedBriefId: briefId }); }
 2051: /** A meeting brief is a snapshot of the evidence at one moment, with the lecturer's recommendation and every receipt. */
 2052: export function prepareEvidenceBrief(subjectId: SubjectId, input: { recommendation: BriefRecommendation; notes: string }): SaveResult & { briefId?: string } {
 2053:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can prepare a brief for this course." };
 2054:   if (!(input.recommendation in RECOMMENDATION_LABEL)) return { ok: false, error: "Choose a recommendation." };
 2055:   if (typeof input.notes !== "string" || input.notes.length > 20000) return { ok: false, error: "Keep the notes within 20,000 characters." };
 2056:   const subject = subjectById(subjectId)!, person = currentPerson()!, at = nowIso();
 2057:   const outcomes = state.clos.filter((c) => c.subjectId === subjectId);
 2058:   const markdown = meetingBriefMarkdown(subject, evidenceReportForCourse(subjectId), state.evidenceSources, state.skillMentions, outcomes, state.people, person,
 2059:     { recommendation: input.recommendation, notes: input.notes.trim() }, at);
 2060:   const brief: EvidenceBrief = { id: nextId("BR-" + subjectId), subjectId, createdBy: person.id, createdAt: at, recommendation: input.recommendation, notes: input.notes.trim(), markdown, recipients: [], sentAt: null };
 2061:   set((s) => ({ evidenceBriefs: [...s.evidenceBriefs, brief], selectedBriefId: brief.id, toast: "Brief prepared. Review it, then download or send it." }));
 2062:   return { ok: true, briefId: brief.id };
 2063: }
 2064: export function sendEvidenceBrief(briefId: string, recipientIds: string[]): SaveResult {
 2065:   const brief = state.evidenceBriefs.find((b) => b.id === briefId);
 2066:   if (!brief || !mayPlan(brief.subjectId)) return { ok: false, error: "You cannot send this brief." };
 2067:   if (brief.sentAt) return { ok: false, error: "This brief was already sent. Prepare a new one to send an update." };
 2068:   const person = currentPerson()!;
 2069:   const recipients = [...new Set(recipientIds)].filter((id) => id !== person.id);
 2070:   if (!recipients.length) return { ok: false, error: "Choose at least one colleague." };
 2071:   if (recipients.some((id) => !personById(id))) return { ok: false, error: "A recipient is unknown to this workspace." };
 2072:   const at = nowIso();
 2073:   set((s) => ({ evidenceBriefs: s.evidenceBriefs.map((b) => (b.id === briefId ? { ...b, recipients, sentAt: at } : b)) }));
 2074:   for (const toPersonId of recipients) notify({ toPersonId, kind: "evidence-brief", subjectId: brief.subjectId, briefId,
 2075:     agentFindings: "Evidence brief for " + brief.subjectId + " from " + person.name + ": " + RECOMMENDATION_LABEL[brief.recommendation] + "." });
 2076:   set({ toast: "Brief sent to " + recipients.map((id) => personById(id)?.name ?? id).join(", ") + "." });
 2077:   return { ok: true };
 2078: }
    1: // Lecturer-supplied evidence (plan Sections 7 and 8, manual path). Pure functions:
    2: // citation validation, duplicate fingerprints, observed-requirement counts with
    3: // explicit denominators, Wilson intervals and reviewed coverage stages. Nothing
    4: // here fetches, scores employability or changes a course.
    5: 
    6: import type {
    7:   BriefRecommendation, CLO, CoverageStage, EvidenceKind, EvidenceSource, MentionRequirement, Person, SkillMapping, SkillMention, Subject,
    8: } from "../types.ts";
    9: 
   10: export const EVIDENCE_KINDS = ["job-posting", "professional-standard", "advisory-note", "other"] as const;
   11: export const COVERAGE_STAGES = ["unknown", "absent", "introduced", "practised", "assessed"] as const;
   12: export const REQUIREMENT_LEVELS = ["required", "preferred", "unclear"] as const;
   13: export const KIND_LABEL: Record<EvidenceKind, string> = {
   14:   "job-posting": "Job posting", "professional-standard": "Professional standard", "advisory-note": "Industry advisory note", other: "Other document",
   15: };
   16: export const STAGE_LABEL: Record<CoverageStage, string> = {
   17:   unknown: "Unknown", absent: "Absent", introduced: "Introduced", practised: "Practised", assessed: "Assessed",
   18: };
   19: /** Ordinal review aid only: a stage difference is not an equal-interval measure. */
   20: export const STAGE_RANK: Record<CoverageStage, number | null> = { unknown: null, absent: 0, introduced: 1, practised: 2, assessed: 3 };
   21: 
   22: export function normaliseWhitespace(text: string): string { return text.replace(/\s+/g, " ").trim(); }
   23: export function skillKey(skill: string): string { return normaliseWhitespace(skill).toLowerCase(); }
   24: /** FNV-1a over the normalised, lower-cased text plus its length. Duplicate detection, not security. */
   25: export function textFingerprint(text: string): string {
   26:   const s = normaliseWhitespace(text).toLowerCase();
   27:   let h = 0x811c9dc5;
   28:   for (let i = 0; i < s.length; i += 1) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
   29:   return "fnv1a-" + h.toString(16).padStart(8, "0") + "-" + s.length.toString(16);
   30: }
   31: 
   32: export type ExcerptLocation =
   33:   | { ok: true; match: "exact" | "whitespace"; start: number; end: number }
   34:   | { ok: false; error: string };
   35: /** The citation validator: the quotation must exist in the retained text. Only spacing may differ. */
   36: export function locateExcerpt(sourceText: string, excerpt: string): ExcerptLocation {
   37:   const quote = excerpt.trim();
   38:   if (!quote) return { ok: false, error: "Quote the exact requirement text from the source." };
   39:   const exact = sourceText.indexOf(quote);
   40:   if (exact >= 0) return { ok: true, match: "exact", start: exact, end: exact + quote.length };
   41:   const normalisedSource = normaliseWhitespace(sourceText), normalisedQuote = normaliseWhitespace(quote);
   42:   const loose = normalisedSource.indexOf(normalisedQuote);
   43:   if (loose >= 0) return { ok: true, match: "whitespace", start: loose, end: loose + normalisedQuote.length };
   44:   return { ok: false, error: "That excerpt was not found in the saved source text. Quote it exactly; only spacing differences are tolerated." };
   45: }
   46: 
   47: export interface EvidenceSourceInput { kind: EvidenceKind; title: string; organisation: string; url: string; sourceDate: string; text: string }
   48: export function evidenceSourceError(input: EvidenceSourceInput): string | null {
   49:   if (!input || !EVIDENCE_KINDS.includes(input.kind)) return "Choose a supported evidence type.";
   50:   for (const key of ["title", "organisation", "url", "sourceDate", "text"] as const) if (typeof input[key] !== "string") return "Invalid evidence source.";
   51:   const title = normaliseWhitespace(input.title), organisation = normaliseWhitespace(input.organisation);
   52:   const url = input.url.trim(), date = input.sourceDate.trim(), text = input.text.trim();
   53:   if (!title || title.length > 200) return "Give the source a title of up to 200 characters.";
   54:   if (organisation.length > 200) return "Keep the organisation name within 200 characters.";
   55:   if (input.kind === "job-posting" && !organisation) return "Name the employer for a job posting.";
   56:   if (url && (url.length > 2000 || !/^https?:\/\/\S+$/i.test(url))) return "Use a full http or https link, or leave the link empty.";
   57:   if (date.length > 40) return "Keep the source date within 40 characters.";
   58:   if (text.length < 20) return "Paste the source text (at least 20 characters).";
   59:   if (text.length > 200000) return "Source text is limited to 200,000 characters.";
   60:   return null;
   61: }
   62: export interface MentionInput { skill: string; excerpt: string; requirement: MentionRequirement }
   63: export function mentionError(input: MentionInput, sourceText: string): string | null {
   64:   if (!input || typeof input.skill !== "string" || typeof input.excerpt !== "string") return "Invalid quotation.";
   65:   const skill = normaliseWhitespace(input.skill);
   66:   if (!skill || skill.length > 120) return "Name the requirement or skill (up to 120 characters).";
   67:   if (!REQUIREMENT_LEVELS.includes(input.requirement)) return "Choose whether the source requires or prefers this skill.";
   68:   const excerpt = input.excerpt.trim();
   69:   if (excerpt.length < 3 || excerpt.length > 2000) return "Quote between 3 and 2,000 characters from the source.";
   70:   const located = locateExcerpt(sourceText, excerpt);
   71:   return located.ok ? null : located.error;
   72: }
   73: export interface MappingInput { skill: string; cloIds: string[]; stage: CoverageStage; target: CoverageStage; evidence: string }
   74: export function mappingError(input: MappingInput, outcomeIds: string[]): string | null {
   75:   if (!input || typeof input.skill !== "string" || !skillKey(input.skill) || input.skill.length > 120) return "Name the skill to map.";
   76:   if (!Array.isArray(input.cloIds) || input.cloIds.some((id) => !outcomeIds.includes(id))) return "Map only to outcomes in the current version of this course.";
   77:   if (new Set(input.cloIds).size !== input.cloIds.length) return "Each outcome can be linked once.";
   78:   if (!COVERAGE_STAGES.includes(input.stage) || !COVERAGE_STAGES.includes(input.target)) return "Choose a valid coverage stage.";
   79:   if (typeof input.evidence !== "string" || input.evidence.length > 5000) return "Keep the coverage evidence within 5,000 characters.";
   80:   if (["introduced", "practised", "assessed"].includes(input.stage) && !input.evidence.trim())
   81:     return "Cite the course evidence (topic, session, assessment or syllabus locator) that shows this stage.";
   82:   return null;
   83: }
   84: 
   85: /** 95% Wilson score interval by default. It describes sampling noise only; it does not repair a convenience sample. */
   86: export function wilsonInterval(successes: number, trials: number, z = 1.959964): { low: number; high: number } | null {
   87:   if (!Number.isFinite(successes) || !Number.isFinite(trials) || trials <= 0 || successes < 0 || successes > trials) return null;
   88:   const p = successes / trials, z2 = z * z, denominator = 1 + z2 / trials;
   89:   const centre = (p + z2 / (2 * trials)) / denominator;
   90:   const half = (z * Math.sqrt((p * (1 - p)) / trials + z2 / (4 * trials * trials))) / denominator;
   91:   // Clamp to the unit interval and absorb floating-point dust at the bounds (10 of 10 reads exactly 1).
   92:   const clamp = (x: number) => (x < 1e-12 ? 0 : x > 1 - 1e-12 ? 1 : x);
   93:   return { low: clamp(centre - half), high: clamp(centre + half) };
   94: }
   95: 
   96: export interface SkillRow {
   97:   key: string; skill: string;
   98:   postings: number; // eligible vacancy clusters quoting the skill (numerator)
   99:   share: number | null; // postings / eligible, unknown when the denominator is empty
  100:   interval: { low: number; high: number } | null;
  101:   required: number; preferred: number; unclear: number; // clusters by their strongest requirement wording
  102:   organisations: string[];
  103:   contextualSources: number; // standards and advisory documents quoting it; never in the denominator
  104:   mapping: SkillMapping | null;
  105:   stage: CoverageStage; target: CoverageStage;
  106:   shortfall: boolean | null; // null until both stage and target are reviewed
  107:   retiredOutcomeIds: string[]; // mapped outcomes no longer in the current course version
  108: }
  109: export interface EvidenceReport {
  110:   eligible: number; // J: reviewed, de-duplicated job postings
  111:   unreviewed: number; duplicates: number; contextual: number; organisations: number;
  112:   rows: SkillRow[];
  113:   targetCoverage: { value: number; unknownWeightShare: number; knownSkills: number } | null;
  114:   coverageNote: string;
  115:   trendNote: string;
  116: }
  117: const STRENGTH: Record<MentionRequirement, number> = { required: 3, preferred: 2, unclear: 1 };
  118: 
  119: export function evidenceReport(subjectId: string, sources: EvidenceSource[], mentions: SkillMention[], mappings: SkillMapping[], outcomes: CLO[]): EvidenceReport {
  120:   const courseSources = sources.filter((s) => s.subjectId === subjectId);
  121:   const byId = new Map(courseSources.map((s) => [s.id, s]));
  122:   const canonicalOf = (s: EvidenceSource) => (s.duplicateOf && byId.get(s.duplicateOf)) || s;
  123:   const canonicals = courseSources.filter((s) => !s.duplicateOf);
  124:   const postings = canonicals.filter((s) => s.kind === "job-posting");
  125:   const eligibleIds = new Set(postings.filter((s) => s.reviewed).map((s) => s.id));
  126:   const contextualIds = new Set(canonicals.filter((s) => s.kind !== "job-posting").map((s) => s.id));
  127:   const J = eligibleIds.size;
  128:   const outcomeIds = new Set(outcomes.map((c) => c.id));
  129:   const groups = new Map<string, { skill: string; clusters: Map<string, MentionRequirement>; contextual: Set<string> }>();
  130:   for (const mention of mentions.filter((m) => m.subjectId === subjectId)) {
  131:     const source = byId.get(mention.sourceId);
  132:     if (!source) continue;
  133:     const cluster = canonicalOf(source), key = skillKey(mention.skill);
  134:     const group = groups.get(key) ?? { skill: normaliseWhitespace(mention.skill), clusters: new Map<string, MentionRequirement>(), contextual: new Set<string>() };
  135:     if (eligibleIds.has(cluster.id)) {
  136:       const previous = group.clusters.get(cluster.id);
  137:       if (!previous || STRENGTH[mention.requirement] > STRENGTH[previous]) group.clusters.set(cluster.id, mention.requirement);
  138:     } else if (contextualIds.has(cluster.id)) group.contextual.add(cluster.id);
  139:     groups.set(key, group);
  140:   }
  141:   const courseMappings = mappings.filter((m) => m.subjectId === subjectId);
  142:   for (const mapping of courseMappings) {
  143:     const key = skillKey(mapping.skill);
  144:     if (!groups.has(key)) groups.set(key, { skill: normaliseWhitespace(mapping.skill), clusters: new Map<string, MentionRequirement>(), contextual: new Set<string>() });
  145:   }
  146:   const rows: SkillRow[] = [...groups.entries()].map(([key, group]) => {
  147:     const n = group.clusters.size, requirements = [...group.clusters.values()];
  148:     const mapping = courseMappings.find((m) => skillKey(m.skill) === key) ?? null;
  149:     const stage = mapping?.stage ?? "unknown", target = mapping?.target ?? "unknown";
  150:     const stageRank = STAGE_RANK[stage], targetRank = STAGE_RANK[target];
  151:     return {
  152:       key, skill: group.skill, postings: n, share: J > 0 ? n / J : null, interval: J > 0 ? wilsonInterval(n, J) : null,
  153:       required: requirements.filter((r) => r === "required").length, preferred: requirements.filter((r) => r === "preferred").length,
  154:       unclear: requirements.filter((r) => r === "unclear").length,
  155:       organisations: [...new Set([...group.clusters.keys()].map((id) => normaliseWhitespace(byId.get(id)?.organisation ?? "")).filter(Boolean))],
  156:       contextualSources: group.contextual.size, mapping, stage, target,
  157:       shortfall: stageRank === null || targetRank === null ? null : stageRank < targetRank,
  158:       retiredOutcomeIds: (mapping?.cloIds ?? []).filter((id) => !outcomeIds.has(id)),
  159:     };
  160:   }).sort((a, b) => b.postings - a.postings || a.skill.localeCompare(b.skill));
  161: 
  162:   let targetCoverage: EvidenceReport["targetCoverage"] = null;
  163:   let coverageNote: string;
  164:   const weighted = rows.filter((r) => r.share !== null && r.share > 0);
  165:   const total = weighted.reduce((sum, r) => sum + (r.share ?? 0), 0);
  166:   if (J === 0) coverageNote = "No reviewed job posting yet, so coverage against observed demand cannot be summarised.";
  167:   else if (!total) coverageNote = "No requirement has been quoted from a reviewed posting yet.";
  168:   else {
  169:     const known = weighted.filter((r) => r.shortfall !== null);
  170:     const knownWeight = known.reduce((sum, r) => sum + (r.share ?? 0), 0);
  171:     if (!knownWeight) coverageNote = "Record a reviewed coverage stage and a target for at least one quoted skill to summarise coverage.";
  172:     else {
  173:       targetCoverage = {
  174:         value: known.filter((r) => !r.shortfall).reduce((sum, r) => sum + (r.share ?? 0), 0) / knownWeight,
  175:         unknownWeightShare: (total - knownWeight) / total, knownSkills: known.length,
  176:       };
  177:       coverageNote = "Demand-weighted share of reviewed skills at or above their target stage. It is an index over quoted skills, not a share of jobs, students or employability.";
  178:     }
  179:   }
  180:   return {
  181:     eligible: J, unreviewed: postings.filter((s) => !s.reviewed).length, duplicates: courseSources.filter((s) => s.duplicateOf).length,
  182:     contextual: contextualIds.size,
  183:     organisations: new Set(postings.filter((s) => eligibleIds.has(s.id)).map((s) => skillKey(s.organisation)).filter(Boolean)).size,
  184:     rows, targetCoverage, coverageNote,
  185:     trendNote: "Trend unavailable: no comparable earlier evidence window has been recorded.",
  186:   };
  187: }
  188: 
  189: const percent = (x: number | null) => (x === null ? "Unknown" : Math.round(x * 1000) / 10 + "%");
  190: 
  191: /** A portable report with receipts. Deterministic, no model call. */
  192: export function evidenceMarkdown(subject: Subject, report: EvidenceReport, sources: EvidenceSource[], mentions: SkillMention[], outcomes: CLO[], people: Person[], generatedAt: string): string {
  193:   const name = (id: string) => people.find((p) => p.id === id)?.name ?? id;
  194:   const label = (id: string) => outcomes.find((c) => c.id === id)?.label ?? id;
  195:   const courseSources = sources.filter((s) => s.subjectId === subject.id);
  196:   const lines = [
  197:     "# " + subject.id + " evidence report", "",
  198:     "Course: " + subject.title, "Generated: " + generatedAt,
  199:     "Scope: lecturer-supplied documents recorded in this workspace. Nothing was collected from the web.", "",
  200:     "## Observed requirements", "",
  201:     "Reviewed job postings in the denominator: " + report.eligible,
  202:     "Excluded: " + report.unreviewed + " unreviewed postings, " + report.duplicates + " duplicate copies, " + report.contextual + " contextual documents (standards and advisory notes are listed, never counted as postings).",
  203:     "Distinct employers among reviewed postings: " + report.organisations,
  204:     report.trendNote, "",
  205:     "| Skill | Postings | Share | 95% interval | Required | Preferred | Employers | Coverage stage | Target | Status |", "|---|---|---|---|---|---|---|---|---|---|",
  206:     ...report.rows.map((r) => "| " + [r.skill, r.postings + " of " + report.eligible, percent(r.share),
  207:       r.interval ? percent(r.interval.low) + " to " + percent(r.interval.high) : "Unknown", r.required, r.preferred, r.organisations.length,
  208:       STAGE_LABEL[r.stage], STAGE_LABEL[r.target], r.shortfall === null ? "Not assessed" : r.shortfall ? "Below target" : "At or above target"].join(" | ") + " |"),
  209:     "",
  210:     report.targetCoverage
  211:       ? "Target coverage index: " + percent(report.targetCoverage.value) + " over " + report.targetCoverage.knownSkills + " skills with a reviewed stage and target. " +
  212:         percent(report.targetCoverage.unknownWeightShare) + " of the quoted demand weight has an unknown stage or target. " + report.coverageNote
  213:       : report.coverageNote,
  214:     "", "## Coverage mappings", "",
  215:     ...(report.rows.some((r) => r.mapping) ? report.rows.filter((r) => r.mapping).map((r) =>
  216:       "- " + r.skill + ": " + STAGE_LABEL[r.stage] + " (target " + STAGE_LABEL[r.target] + "). Outcomes: " +
  217:       (r.mapping!.cloIds.map((id) => label(id) + (r.retiredOutcomeIds.includes(id) ? " (retired)" : "")).join(", ") || "none") +
  218:       ". Evidence: " + (r.mapping!.evidence || "not cited") + ".") : ["No coverage mapping recorded."]),
  219:     "", "## Limitations", "",
  220:     "- This is a convenience sample chosen by the lecturer; shares and intervals describe the recorded set, not the labour market.",
  221:     "- A posting counts once however many sites repeat it; a skill counts once however often one posting repeats it.",
  222:     "- Coverage stages are the lecturer's reviewed judgement with cited course evidence. They are ordinal review aids, not mastery.",
  223:     "- No learning impact is estimated. Nothing in this report changes the course by itself.",
  224:     "", "## Receipts", "",
  225:   ];
  226:   for (const source of courseSources.filter((s) => !s.duplicateOf)) {
  227:     const copies = courseSources.filter((c) => c.duplicateOf === source.id);
  228:     lines.push("### " + source.title + (source.organisation ? " (" + source.organisation + ")" : ""), "",
  229:       "Type: " + KIND_LABEL[source.kind], "Source date: " + (source.sourceDate || "not supplied"), "Link: " + (source.url || "not supplied"),
  230:       "Recorded: " + source.addedAt + " by " + name(source.addedBy) + (source.collection ? ", from " + source.collection.label + ", retrieved " + source.collection.retrievedAt : ", lecturer-supplied"),
  231:       "Text fingerprint: " + source.textHash,
  232:       "Extraction: " + (source.kind === "job-posting" ? (source.reviewed ? "reviewed, counted" : "not yet reviewed, excluded") : "contextual document"),
  233:       "Duplicate copies recorded: " + copies.length, "", "Quoted requirements:", "");
  234:     const quotes = mentions.filter((m) => m.sourceId === source.id || copies.some((c) => c.id === m.sourceId));
  235:     lines.push(...(quotes.length ? quotes.map((m) => "- " + m.skill + " (" + m.requirement + "): \"" + m.excerpt.replace(/\s+/g, " ") + "\"") : ["- None quoted yet."]), "");
  236:   }
  237:   if (!courseSources.length) lines.push("No source recorded.", "");
  238:   return lines.join("\n");
  239: }
  240: 
  241: // ---------- requirement scan: lexicon-assisted proposals the lecturer confirms ----------
  242: /** Comma or newline separated terms; `|` separates aliases. Duplicates by first alias are dropped. */
  243: export function parseLexicon(text: string): string[] {
  244:   const seen = new Set<string>(), terms: string[] = [];
  245:   for (const raw of text.split(/[,\n;]+/)) {
  246:     const term = normaliseWhitespace(raw);
  247:     if (!term || term.length > 60) continue;
  248:     const key = skillKey(term.split("|")[0] ?? "");
  249:     if (!key || seen.has(key)) continue;
  250:     seen.add(key); terms.push(term);
  251:     if (terms.length >= 100) break;
  252:   }
  253:   return terms;
  254: }
  255: export interface MentionProposal { sourceId: string; sourceTitle: string; term: string; skill: string; excerpt: string; requirement: MentionRequirement }
  256: const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  257: const REQUIRED_WORDS = /\b(must|required|require[sd]?|essential|need(?:s|ed)?|minimum|mandatory|expected)\b/i;
  258: const PREFERRED_WORDS = /\b(preferred|preferably|nice to have|bonus|a plus|desirable|ideally|advantage)\b/i;
  259: /** A heuristic reading of one sentence. The lecturer can change it before confirming. */
  260: export function classifyRequirement(sentence: string): MentionRequirement {
  261:   if (PREFERRED_WORDS.test(sentence)) return "preferred";
  262:   if (REQUIRED_WORDS.test(sentence)) return "required";
  263:   return "unclear";
  264: }
  265: function clipExcerpt(sentence: string, pattern: RegExp): string {
  266:   if (sentence.length <= 240) return sentence;
  267:   const at = Math.max(0, sentence.search(pattern));
  268:   const start = Math.max(0, at - 110), end = Math.min(sentence.length, at + 130);
  269:   let clip = sentence.slice(start, end);
  270:   if (start > 0 && clip.includes(" ")) clip = clip.slice(clip.indexOf(" ") + 1);
  271:   if (end < sentence.length && clip.includes(" ")) clip = clip.slice(0, clip.lastIndexOf(" "));
  272:   return clip.trim();
  273: }
  274: /** One proposal per original source and term: the first sentence that uses the term or an alias, as an exact substring.
  275:  *  Sources already quoted for that skill are skipped. The scan records nothing; the lecturer confirms. */
  276: export function proposeMentions(sources: EvidenceSource[], terms: string[], existing: SkillMention[]): MentionProposal[] {
  277:   const proposals: MentionProposal[] = [];
  278:   const recorded = new Set(existing.map((m) => m.sourceId + "\n" + skillKey(m.skill)));
  279:   for (const source of sources.filter((s) => !s.duplicateOf)) {
  280:     const sentences = source.text.split(/(?<=[.!?])\s+|\n+/).map((s) => s.trim()).filter((s) => s.length >= 3);
  281:     for (const term of terms) {
  282:       const aliases = term.split("|").map((a) => normaliseWhitespace(a)).filter(Boolean);
  283:       const skill = aliases[0];
  284:       if (!skill || recorded.has(source.id + "\n" + skillKey(skill))) continue;
  285:       const pattern = new RegExp("(?<![\\p{L}\\p{N}])(?:" + aliases.map(escapeRegExp).join("|") + ")(?![\\p{L}\\p{N}])", "iu");
  286:       const sentence = sentences.find((s) => pattern.test(s));
  287:       if (!sentence) continue;
  288:       proposals.push({ sourceId: source.id, sourceTitle: source.title, term, skill, excerpt: clipExcerpt(sentence, pattern), requirement: classifyRequirement(sentence) });
  289:     }
  290:   }
  291:   return proposals;
  292: }
  293: 
  294: // ---------- meeting brief: the evidence as a document for people ----------
  295: export const RECOMMENDATION_LABEL: Record<BriefRecommendation, string> = {
  296:   keep: "Keep the course unchanged this term", refresh: "Small refresh within existing hours", revise: "Propose a formal revision", undecided: "No recommendation yet; discussion requested",
  297: };
  298: const OPTION_NOTE: Record<BriefRecommendation, string> = {
  299:   keep: "no change to outcomes, topics or hours; revisit next term with refreshed evidence.",
  300:   refresh: "adjust activities, examples or one topic within the existing hours and outcomes; private preparation needs no formal approval.",
  301:   revise: "change outcomes or topics through the institution's review process, stating the hours and prerequisites it affects.",
  302:   undecided: "the lecturer asks the meeting to weigh the options above.",
  303: };
  304: export function meetingBriefMarkdown(subject: Subject, report: EvidenceReport, sources: EvidenceSource[], mentions: SkillMention[], outcomes: CLO[], people: Person[], author: Person, input: { recommendation: BriefRecommendation; notes: string }, generatedAt: string): string {
  305:   const courseSources = sources.filter((s) => s.subjectId === subject.id && !s.duplicateOf);
  306:   const postings = courseSources.filter((s) => s.kind === "job-posting");
  307:   const dates = postings.map((s) => s.sourceDate).filter(Boolean).sort();
  308:   const collected = postings.filter((s) => s.provenance === "collected");
  309:   const labels = [...new Set(collected.map((s) => s.collection?.label ?? "collected on request"))];
  310:   const top = report.rows.filter((r) => r.postings > 0).slice(0, 10);
  311:   const status = (r: SkillRow) => (r.shortfall === null ? "Not assessed" : r.shortfall ? "Below target" : "At or above target");
  312:   const options: BriefRecommendation[] = ["keep", "refresh", "revise", ...(input.recommendation === "undecided" ? ["undecided" as const] : [])];
  313:   return [
  314:     "# Meeting brief: " + subject.id + " " + subject.title, "",
  315:     "Prepared by " + author.name + " on " + generatedAt + ". Lecturer-controlled preparation; this brief does not attest institutional approval.", "",
  316:     "## Decision requested", "", RECOMMENDATION_LABEL[input.recommendation] + ".", "",
  317:     "## Evidence base", "",
  318:     "- Reviewed job postings in the denominator: " + report.eligible + ", from " + report.organisations + " employers.",
  319:     "- Publication dates as supplied: " + (dates.length ? dates[0] + " to " + dates[dates.length - 1] : "not supplied") + ".",
  320:     "- Sources: " + collected.length + " collected on request (" + (labels.join("; ") || "none") + "), " + (postings.length - collected.length) + " lecturer-supplied, " + report.contextual + " contextual documents.",
  321:     "- Excluded from the denominator: " + report.unreviewed + " unreviewed postings and " + report.duplicates + " duplicate copies.",
  322:     "- " + report.trendNote, "",
  323:     "## What employers ask for", "",
  324:     ...(top.length ? ["| Skill | Postings | Share | 95% interval | Coverage today | Target | Status |", "|---|---|---|---|---|---|---|",
  325:       ...top.map((r) => "| " + [r.skill, r.postings + " of " + report.eligible, percent(r.share), r.interval ? percent(r.interval.low) + " to " + percent(r.interval.high) : "Unknown",
  326:         STAGE_LABEL[r.stage], STAGE_LABEL[r.target], status(r)].join(" | ") + " |")] : ["No requirement has been quoted from a reviewed posting yet."]), "",
  327:     "## Coverage against targets", "",
  328:     report.targetCoverage
  329:       ? "Target coverage index: " + percent(report.targetCoverage.value) + " over " + report.targetCoverage.knownSkills + " skills with a reviewed stage and target; " + percent(report.targetCoverage.unknownWeightShare) + " of the quoted demand weight has an unknown stage or target. " + report.coverageNote
  330:       : report.coverageNote, "",
  331:     "## Options considered", "",
  332:     ...options.map((o) => "- " + RECOMMENDATION_LABEL[o] + (o === input.recommendation ? " (recommended)" : "") + ": " + OPTION_NOTE[o]), "",
  333:     "## Lecturer's notes", "", input.notes || "None recorded.", "",
  334:     "## Limitations", "",
  335:     "- A convenience sample chosen by the lecturer; shares and intervals describe the recorded set, not the labour market.",
  336:     "- Coverage stages are the lecturer's reviewed judgement with cited course evidence; they are ordinal review aids, not mastery.",
  337:     "- No learning impact is estimated, and nothing in this brief changes the course by itself.", "",
  338:     "## Appendix: evidence report with receipts", "",
  339:     evidenceMarkdown(subject, report, sources, mentions, outcomes, people, generatedAt),
  340:   ].join("\n");
  341: }

