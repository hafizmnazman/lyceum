 103:   function stop() {
 104:     abortRef.current = true;
 105:     setClockPinned(false);
 106:     demoAudio.stop();
 107:     setPhase("idle");
 108:     setCursor({ x: -100, y: -100 });
 109:     setCaption("");
 110:   }
