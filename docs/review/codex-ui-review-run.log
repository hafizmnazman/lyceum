 1688: // ---------- lecturer-controlled curriculum revisions ----------
 1689: export function definitionForCourse(subjectId: SubjectId): CourseDefinition | null {
 1690:   const subject = subjectById(subjectId);
 1691:   if (!subject) return null;
 1692:   return structuredClone(state.courseDefinitions[subjectId] ?? courseDefinition(subject, state.clos, state.programme.title));
 1693: }
 1694: export function createCourseWorkspace(input: { code: string; title: string; programmeTitle: string; year: number; semester: number }): SaveResult & { subjectId?: string } {
 1695:   const person = currentPerson();
 1696:   if (!person || person.orgRole !== "academic") return { ok: false, error: "Use a lecturer workspace to create a personal course." };
 1697:   const code = input.code.trim().toUpperCase();
 1698:   if (!/^[A-Z0-9][A-Z0-9._-]{1,39}$/.test(code)) return { ok: false, error: "Use a course code of 2 to 40 letters, numbers, dots, underscores or hyphens." };
 1699:   if (state.subjects.some(s => s.id.toUpperCase() === code)) return { ok: false, error: "That course code is already in this workspace." };
 1700:   if (!input.title.trim() || input.title.length > 200) return { ok: false, error: "Give the course a title of up to 200 characters." };
 1701:   if (!Number.isInteger(input.year) || input.year < 1 || input.year > 12 || !Number.isInteger(input.semester) || input.semester < 1 || input.semester > 4)
 1702:     return { ok: false, error: "Use a year from 1 to 12 and a semester from 1 to 4." };
 1703:   const versionId = nextId(code + "-workspace");
 1704:   const subject: Subject = { id: code, title: input.title.trim(), programmeId: state.programme.id,
 1705:     year: input.year, semester: input.semester, cloIds: [], prerequisiteSubjectIds: [],
 1706:     sharedWithProgrammeIds: [], status: "proposed", currentVersionId: versionId, workspaceOnly: true };
 1707:   const definition = courseDefinition(subject, [], input.programmeTitle.trim());
 1708:   set(s => ({ subjects: [...s.subjects, subject], courseDefinitions: { ...s.courseDefinitions, [code]: definition },
 1709:     assignments: [...s.assignments, { personId: person.id, subjectId: code, hat: "lecturer" }],
 1710:     programme: { ...s.programme, subjectIds: [...s.programme.subjectIds, code] },
 1711:     subjectVersions: [...s.subjectVersions, { id: versionId, subjectId: code,
 1712:       snapshot: { title: subject.title, cloIds: [], prerequisiteSubjectIds: [] }, cloSnapshot: [],
 1713:       definition: structuredClone(definition), changedBy: person.id, changedAt: nowIso(),
 1714:       reason: "Personal course workspace created; not institutional approval." }],
 1715:     selectedSubjectId: code, selectedProposalId: null, studioTab: "curriculum", screen: "studio",
 1716:     toast: "Course created. Add learning outcomes and a topic outline." }));
 1717:   startCurriculumRevision(code);
 1718:   return { ok: true, subjectId: code };
 1719: }
 1720: export function startCurriculumRevision(subjectId: SubjectId): SaveResult & { draftId?: string } {
 1721:   if (!mayPlan(subjectId)) return { ok: false, error: "Only an assigned lecturer or coordinator can revise this course." };
 1722:   const existing = state.curriculumDrafts.find(d => d.subjectId === subjectId && d.status === "drafting");
 1723:   if (existing) return { ok: true, draftId: existing.id };
 1724:   const subject = subjectById(subjectId)!;
 1725:   const definition = definitionForCourse(subjectId)!;
 1726:   const person = currentPerson()!;
 1727:   const draft: CurriculumDraft = { id: nextId("REV-" + subjectId), subjectId, baselineVersionId: subject.currentVersionId,
 1728:     revision: 1, definition, reason: "", effectiveTerm: "", status: "drafting", checkedRevision: null,
 1729:     history: [{ at: nowIso(), byPersonId: person.id, action: "created", note: "Revision started from " + subject.currentVersionId, revision: 1 }] };
 1730:   const baseline: SubjectVersion = { id: subject.currentVersionId, subjectId,
 1731:     snapshot: { title: subject.title, cloIds: [...subject.cloIds], prerequisiteSubjectIds: [...subject.prerequisiteSubjectIds] },
 1732:     cloSnapshot: structuredClone(state.clos.filter(c => c.subjectId === subjectId)), definition: structuredClone(definition),
 1733:     changedBy: person.id, changedAt: nowIso(), reason: "Baseline preserved before revision." };
 1734:   set(s => ({ curriculumDrafts: [...s.curriculumDrafts, draft],
 1735:     subjectVersions: s.subjectVersions.some(v => v.id === baseline.id)
 1736:       ? s.subjectVersions.map(v => v.id === baseline.id && !v.definition ? { ...v, definition: structuredClone(definition) } : v)
 1737:       : [...s.subjectVersions, baseline], toast: "Revision started. The current course is unchanged." }));
 1738:   return { ok: true, draftId: draft.id };
 1739: }
 1740: function editableRevision(draftId: string, expectedRevision: number): CurriculumDraft | string {
 1741:   const draft = state.curriculumDrafts.find(d => d.id === draftId);
 1742:   if (!draft || !mayPlan(draft.subjectId)) return "You cannot edit this course revision.";
 1743:   if (draft.status !== "drafting") return "This revision is closed. Start a new revision.";
 1744:   if (draft.revision !== expectedRevision) return "The saved revision changed. Reload it before saving your edits.";
 1745:   if (subjectById(draft.subjectId)?.currentVersionId !== draft.baselineVersionId) return "The current course version changed. Start a revision from the latest version.";
 1746:   return draft;
 1747: }
 1748: export function saveCurriculumRevision(draftId: string, expectedRevision: number,
 1749:   input: { definition: CourseDefinition; reason: string; effectiveTerm: string }): SaveResult {
 1750:   const draft = editableRevision(draftId, expectedRevision);
 1751:   if (typeof draft === "string") return { ok: false, error: draft };
 1752:   const error = draftStructureError(input.definition, draft.subjectId);
 1753:   if (error) return { ok: false, error };
 1754:   if (input.definition.outcomes.some(c => state.clos.some(existing => existing.id === c.id && existing.subjectId !== draft.subjectId))) return { ok: false, error: "An outcome identity belongs to another course." };
 1755:   if (typeof input.reason !== "string" || input.reason.length > 50000 || typeof input.effectiveTerm !== "string" || input.effectiveTerm.length > 100)
 1756:     return { ok: false, error: "Invalid revision rationale or teaching term." };
 1757:   const revision = draft.revision + 1;
 1758:   set(s => ({ curriculumDrafts: s.curriculumDrafts.map(d => d.id === draftId ? {
 1759:     ...d, definition: structuredClone(input.definition), reason: input.reason.trim(), effectiveTerm: input.effectiveTerm.trim(),
 1760:     revision, checkedRevision: null, history: [...d.history, { at: nowIso(), byPersonId: currentPerson()!.id,
 1761:       action: "saved", note: "Candidate edited; previous checks invalidated.", revision }] } : d), toast: "Revision saved. Current course version is unchanged." }));
 1762:   return { ok: true };
 1763: }
 1764: export function checkCurriculumRevision(draftId: string, expectedRevision: number): SaveResult {
 1765:   const draft = editableRevision(draftId, expectedRevision);
 1766:   if (typeof draft === "string") return { ok: false, error: draft };
 1767:   const baseline = state.subjectVersions.find(v => v.id === draft.baselineVersionId)?.definition;
 1768:   const errors = validateCourseDefinition(draft.definition, draft.subjectId, baseline).filter(i => i.severity === "error");
 1769:   if (errors.length) return { ok: false, error: errors.map(e => e.message).join(" ") };
 1770:   set(s => ({ curriculumDrafts: s.curriculumDrafts.map(d => d.id === draftId ? { ...d, checkedRevision: d.revision,
 1771:     history: [...d.history, { at: nowIso(), byPersonId: currentPerson()!.id, action: "checked",
 1772:       note: "Configured constraints checked. Academic judgement and institutional review remain required.", revision: d.revision }] } : d),
 1773:     toast: "Constraints checked. Review warnings and the change summary." }));
 1774:   return { ok: true };
 1775: }
 1776: export function adoptCurriculumRevision(draftId: string, expectedRevision: number, acknowledgement: boolean): SaveResult {
 1777:   const draft = editableRevision(draftId, expectedRevision);
 1778:   if (typeof draft === "string") return { ok: false, error: draft };
 1779:   if (draft.checkedRevision !== draft.revision) return { ok: false, error: "Check this saved revision before using it." };
 1780:   if (!draft.reason.trim() || !draft.effectiveTerm.trim()) return { ok: false, error: "Record the decision rationale and teaching term." };
 1781:   if (!acknowledgement) return { ok: false, error: "Confirm the local decision boundary and review the affected teaching work." };
 1782:   if (draft.definition.outcomes.some(c => state.clos.some(existing => existing.id === c.id && existing.subjectId !== draft.subjectId))) return { ok: false, error: "An outcome identity now belongs to another course." };
 1783:   const subject = subjectById(draft.subjectId)!;
 1784:   const baseline = definitionForCourse(subject.id)!;
 1785:   const errors = validateCourseDefinition(draft.definition, subject.id, baseline).filter(i => i.severity === "error");
 1786:   if (errors.length) return { ok: false, error: errors.map(e => e.message).join(" ") };
 1787:   if (!curriculumChanges(baseline, draft.definition).length) return { ok: false, error: "There are no course changes to save as a new version." };
 1788:   const person = currentPerson()!;
 1789:   const at = nowIso(), versionId = nextId(subject.id + "-workspace");
 1790:   const def = structuredClone(draft.definition);
 1791:   const impact = curriculumImpact(baseline, def, state.teachingPlans.find(p => p.subjectId === subject.id),
 1792:     state.testDrafts.filter(t => t.subjectId === subject.id));
 1793:   const version: SubjectVersion = { id: versionId, subjectId: subject.id,
 1794:     snapshot: { title: def.title.trim(), cloIds: def.outcomes.map(c => c.id), prerequisiteSubjectIds: [...subject.prerequisiteSubjectIds] },
 1795:     cloSnapshot: def.outcomes.map(c => ({ ...c })), definition: structuredClone(def), effectiveTerm: draft.effectiveTerm,
 1796:     changedBy: person.id, changedAt: at, reason: draft.reason };
 1797:   set(s => ({ courseDefinitions: { ...s.courseDefinitions, [subject.id]: def },
 1798:     clos: [...s.clos.filter(c => c.subjectId !== subject.id), ...def.outcomes.map(c => ({ ...c }))],
 1799:     subjects: s.subjects.map(c => c.id === subject.id ? { ...c, title: def.title.trim(),
 1800:       cloIds: def.outcomes.map(o => o.id), currentVersionId: versionId } : c),
 1801:     subjectVersions: [...s.subjectVersions, version],
 1802:     curriculumDrafts: s.curriculumDrafts.map(d => d.id === draftId ? { ...d, status: "adopted",
 1803:       history: [...d.history, { at, byPersonId: person.id, action: "adopted", note: "Used as local course version " + versionId + ". " + draft.reason, revision: d.revision }] } : d),
 1804:     teachingPlans: s.teachingPlans.map(p => p.subjectId === subject.id ? { ...p,
 1805:       sessions: p.sessions.map(session => impact.sessions.some(x => x.id === session.id)
 1806:         ? { ...session, needsReview: true, courseVersionId: session.courseVersionId ?? subject.currentVersionId } : session) } : p),
 1807:     testDrafts: s.testDrafts.map(t => impact.assessments.some(x => x.id === t.id)
 1808:       ? { ...t, needsReview: true, status: "drafting" } : t),
 1809:     proposals: s.proposals.map(p => p.subjectId === subject.id && p.status !== "approved" && p.status !== "rejected"
 1810:       ? { ...p, baselineVersionId: p.baselineVersionId ?? subject.currentVersionId, acceptanceResult: undefined, status: "drafting" } : p),
 1811:     toast: "New local course version saved. Review affected teaching sessions and assessments." }));
 1812:   return { ok: true };
 1813: }
 1814: export function discardCurriculumRevision(draftId: string, expectedRevision: number, note: string): SaveResult {
 1815:   const draft = state.curriculumDrafts.find(d => d.id === draftId);
 1816:   if (!draft || !mayPlan(draft.subjectId) || draft.status !== "drafting") return { ok: false, error: "You cannot discard this revision." };
 1817:   if (draft.revision !== expectedRevision) return { ok: false, error: "The revision changed; reload it first." };
 1818:   if (!note.trim()) return { ok: false, error: "Record why you are discarding this revision." };
 1819:   set(s => ({ curriculumDrafts: s.curriculumDrafts.map(d => d.id === draftId ? { ...d, status: "discarded",
 1820:     history: [...d.history, { at: nowIso(), byPersonId: currentPerson()!.id, action: "discarded", note: note.trim(), revision: d.revision }] } : d),
 1821:     toast: "Revision discarded. The current course version is unchanged." }));
 1822:   return { ok: true };
 1823: }
