 1607: // ---------- department: create subject + assign hats ----------
 1608: export function createSubject(args: {
 1609:   id: SubjectId;
 1610:   title: string;
 1611:   year: number;
 1612:   semester: number;
 1613:   coordinatorId: PersonId;
 1614:   cloText: string;
 1615: }): SubjectId {
 1616:   const cloId = `${args.id}-CLO1`;
 1617:   const subject: Subject = {
 1618:     id: args.id,
 1619:     title: args.title,
 1620:     programmeId: state.programme.id,
 1621:     year: args.year,
 1622:     semester: args.semester,
 1623:     cloIds: [cloId],
 1624:     prerequisiteSubjectIds: [],
 1625:     sharedWithProgrammeIds: [],
 1626:     status: "proposed",
 1627:     currentVersionId: `${args.id}-v1`,
 1628:   };
 1629:   const clo: CLO = { id: cloId, subjectId: args.id, text: args.cloText, bloomLevel: "Apply" };
 1630:   const proposal: ChangeProposal = {
 1631:     id: `CP-${args.id}-001`,
 1632:     subjectId: args.id,
 1633:     kind: "new-subject",
 1634:     authorId: args.coordinatorId,
 1635:     draft: {
 1636:       topics: [args.cloText],
 1637:       cloChanges: [{ cloId, op: "add", text: args.cloText, bloomLevel: "Apply" }],
 1638:     },
 1639:     status: "drafting",
 1640:     history: [
 1641:       { at: nowIso(), byPersonId: state.programme.departmentOwnerId, action: "drafted", note: "New subject scoped." },
 1642:     ],
 1643:   };
 1644:   set((s) => ({
 1645:     subjects: [...s.subjects, subject],
 1646:     clos: [...s.clos, clo],
 1647:     assignments: [...s.assignments, { personId: args.coordinatorId, subjectId: args.id, hat: "coordinator" }],
 1648:     proposals: [...s.proposals, proposal],
 1649:     toast: `Created ${args.id} and assigned a coordinator.`,
 1650:   }));
 1651:   return args.id;
 1652: }
 1653: 
 1654: export function assignHat(personId: PersonId, subjectId: SubjectId, hat: Hat) {
 1655:   if (state.assignments.some((a) => a.personId === personId && a.subjectId === subjectId && a.hat === hat))
 1656:     return;
 1657:   set((s) => ({ assignments: [...s.assignments, { personId, subjectId, hat }], toast: "Hat assigned." }));
 1658: }
