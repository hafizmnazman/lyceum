 1826: let recoveryBackup: string | null = null;
 1827: const RECOVERY_KEY = "lyceum-v3-pre-restore@1";
 1828: export function exportWorkspaceBackup(): string {
 1829:   return serializeWorkspaceBackup(state, nowIso());
 1830: }
 1831: export function previewWorkspaceBackup(raw: string) {
 1832:   if (!currentPerson()) return { ok: false as const, error: "Open a local workspace before importing a backup." };
 1833:   const result = parseWorkspaceBackup(raw, state.people.map(p => p.id));
 1834:   return result.ok ? { ok: true as const, summary: backupSummary(result.backup.data),
 1835:     exportedAt: result.backup.exportedAt, fingerprint: workspaceFingerprint(state) } : result;
 1836: }
 1837: export function getRecoveryBackup(): string | null {
 1838:   if (recoveryBackup) return recoveryBackup;
 1839:   if (typeof window === "undefined") return null;
 1840:   try { return localStorage.getItem(RECOVERY_KEY); } catch { return null; }
 1841: }
 1842: export function restoreWorkspaceBackup(raw: string, expectedFingerprint: string, acknowledged: boolean): SaveResult {
 1843:   if (!currentPerson()) return { ok: false, error: "Open a local workspace before restoring." };
 1844:   if (!acknowledged) return { ok: false, error: "Confirm that you want to replace this browser workspace." };
 1845:   if (workspaceFingerprint(state) !== expectedFingerprint) return { ok: false, error: "The workspace changed after preview. Preview the backup again." };
 1846:   const parsed = parseWorkspaceBackup(raw, state.people.map(p => p.id));
 1847:   if (!parsed.ok) return parsed;
 1848:   const recovery = exportWorkspaceBackup();
 1849:   const next: AppState = { ...seedState(), ...structuredClone(parsed.backup.data),
 1850:     currentPersonId: state.currentPersonId, screen: "guide", persistenceStatus: "saved",
 1851:     selectedSubjectId: null, selectedProposalId: null, toast: "Workspace restored. A pre-restore recovery backup is available." };
 1852:   if (typeof window !== "undefined") {
 1853:     try {
 1854:       localStorage.setItem(RECOVERY_KEY, recovery);
 1855:       const persisted = Object.fromEntries(PERSISTED_KEYS.map(k => [k, next[k]]));
 1856:       localStorage.setItem(STORAGE_KEY, JSON.stringify(persisted));
 1857:     } catch {
 1858:       return { ok: false, error: "Storage could not save the recovery and restored workspace. Nothing was replaced. Export your current workspace first." };
 1859:     }
 1860:   }
 1861:   if (saveTimer) clearTimeout(saveTimer);
 1862:   if (simTimer) clearInterval(simTimer);
 1863:   if (signalTimer) clearInterval(signalTimer);
 1864:   if (drillTimer) clearInterval(drillTimer);
 1865:   saveTimer = null; simTimer = null; signalTimer = null; drillTimer = null;
 1866:   recoveryBackup = recovery;
 1867:   state = next;
 1868:   emit();
 1869:   return { ok: true };
 1870: }
