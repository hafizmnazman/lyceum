 1665: // ---------- reset (workspace + demo) ----------
 1666: /** Reset the mutable world to seed and stop every timer. Used by the account
 1667:  *  menu's "Reset workspace" and by the self-driving demo on each Play. */
 1668: export function resetDemoState() {
 1669:   if (simTimer) clearInterval(simTimer);
 1670:   simTimer = null;
 1671:   if (signalTimer) clearInterval(signalTimer);
 1672:   signalTimer = null;
 1673:   if (drillTimer) clearInterval(drillTimer);
 1674:   drillTimer = null;
 1675:   if (typeof window !== "undefined") {
 1676:     try {
 1677:       localStorage.removeItem(STORAGE_KEY);
 1678:     } catch {
 1679:       // fine: the in-memory reset below still applies
 1680:     }
 1681:   }
 1682:   state = seedState();
 1683:   emit();
 1684: }
 1685: export const resetWorkspace = resetDemoState;
