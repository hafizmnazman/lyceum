 265: function clipExcerpt(sentence: string, pattern: RegExp): string {
 266:   if (sentence.length <= 240) return sentence;
 267:   const at = Math.max(0, sentence.search(pattern));
 268:   const start = Math.max(0, at - 110), end = Math.min(sentence.length, at + 130);
 269:   let clip = sentence.slice(start, end);
 270:   if (start > 0 && clip.includes(" ")) clip = clip.slice(clip.indexOf(" ") + 1);
 271:   if (end < sentence.length && clip.includes(" ")) clip = clip.slice(0, clip.lastIndexOf(" "));
 272:   return clip.trim();
 273: }
 274: /** One proposal per original source and term: the first sentence that uses the term or an alias, as an exact substring.
 275:  *  Sources already quoted for that skill are skipped. The scan records nothing; the lecturer confirms. */
 276: export function proposeMentions(sources: EvidenceSource[], terms: string[], existing: SkillMention[]): MentionProposal[] {
 277:   const proposals: MentionProposal[] = [];
 278:   const recorded = new Set(existing.map((m) => m.sourceId + "\n" + skillKey(m.skill)));
 279:   for (const source of sources.filter((s) => !s.duplicateOf)) {
 280:     const sentences = source.text.split(/(?<=[.!?])\s+|\n+/).map((s) => s.trim()).filter((s) => s.length >= 3);
 281:     for (const term of terms) {
 282:       const aliases = term.split("|").map((a) => normaliseWhitespace(a)).filter(Boolean);
 283:       const skill = aliases[0];
 284:       if (!skill || recorded.has(source.id + "\n" + skillKey(skill))) continue;
 285:       const pattern = new RegExp("(?<![\\p{L}\\p{N}])(?:" + aliases.map(escapeRegExp).join("|") + ")(?![\\p{L}\\p{N}])", "iu");
 286:       const sentence = sentences.find((s) => pattern.test(s));
 287:       if (!sentence) continue;
 288:       proposals.push({ sourceId: source.id, sourceTitle: source.title, term, skill, excerpt: clipExcerpt(sentence, pattern), requirement: classifyRequirement(sentence) });
 289:     }
 290:   }
 291:   return proposals;
 292: }
