{
  "name": "lyceum",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Lyceum: the independent advisory layer that rates every course against triangulated industry demand, helps the faculty fix the drift, and scores its own advice against the next term's real results.",
  "author": "Hafiz Azman",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node --watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prove": "node src/prove-acceptance.ts",
    "prove:backtest": "node src/prove-backtest.ts",
    "prove:flow": "node src/prove-flow.ts",
    "prove:signal": "node src/prove-signal.ts",
    "prove:intake": "node src/prove-intake.ts",
    "prove:all": "node src/prove-acceptance.ts && node src/prove-backtest.ts && node src/prove-flow.ts && node src/prove-signal.ts && node src/prove-intake.ts",
    "gen:demo": "node scripts/gen-demo-files.mjs",
    "gen:music": "node scripts/gen-music.mjs",
    "smoke": "node scripts/demo-smoke.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^0.12.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
